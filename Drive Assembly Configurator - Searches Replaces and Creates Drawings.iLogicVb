'====================================================
' REQUIRED COMPONENT CHECK
'====================================================
Sub CheckRequiredComponentExists( _
    ByVal componentName As String, _
    ByVal searchCriteria As System.Collections.Generic.Dictionary(Of String, String), _
    ByRef missingRequired As String)

    Dim missingParamText As String = GetMissingCriteriaText(searchCriteria)

    If Trim(missingParamText) <> "" Then
        AddMissingRequiredLine(missingRequired, componentName & " : Missing search value(s): " & missingParamText)
        Exit Sub
    End If

    Try

        Dim foundFile As String = GetFileBySearchCriteriaWithWildcards(searchCriteria)

        If Trim(foundFile) = "" Then

            If HasNewPartInput(componentName) Then
                Exit Sub
            End If

            AddMissingRequiredLine(missingRequired, componentName & " : No Vault match found and no New PN / Save Location was entered.")
            Exit Sub

        End If

        StoreFoundVaultFile(componentName, foundFile)

    Catch ex As Exception

        AddMissingRequiredLine(missingRequired, componentName & " : Vault search failed - " & ex.Message)

    End Try

End Sub


'====================================================
' REPLACE OPTIONAL COMPONENT
'====================================================
Sub ReplaceOptionalComponent( _
    ByVal rootAsm As AssemblyDocument, _
    ByVal targetTitle As String, _
    ByVal searchParams As System.Collections.Generic.Dictionary(Of String, String), _
    ByVal fallbackSourceFile As String, _
    ByRef swapReport As String, _
    ByRef anySwap As Boolean)

    If rootAsm Is Nothing Then Exit Sub

    If Trim(GetMissingCriteriaText(searchParams)) <> "" Then
        swapReport &= targetTitle & " : Cannot search - missing " & GetMissingCriteriaText(searchParams) & vbCrLf
        Exit Sub
    End If

    ReplaceComponentByCriteria(rootAsm, targetTitle, searchParams, fallbackSourceFile, swapReport, anySwap)

End Sub


'====================================================
' REPLACE STANDARD COMPONENTS
'====================================================
Sub ReplaceComponentByCriteria( _
    ByVal rootAsm As AssemblyDocument, _
    ByVal targetTitle As String, _
    ByVal searchParams As System.Collections.Generic.Dictionary(Of String, String), _
    ByVal fallbackSourceFile As String, _
    ByRef swapReport As String, _
    ByRef anySwap As Boolean)

    If rootAsm Is Nothing Then Exit Sub

    Dim newFile As String = FindFileByCriteriaOrCreateNew(rootAsm, targetTitle, searchParams, fallbackSourceFile, swapReport)

    If Trim(newFile) = "" Then Exit Sub

    '====================================================
    ' GET PART NUMBER
    '
    ' If this file was just created, the real iProperty may
    ' still have the old template PN until properties are
    ' processed later.
    '
    ' Use the stored Configurator PN first.
    '====================================================
    Dim newPN As String = GetConfiguredComponentPartNumber(targetTitle)

    If Trim(newPN) = "" Then
        newPN = GetPartNumber(newFile)
    End If

    If Trim(newPN) = "" Or UCase(Trim(newPN)) = "UNKNOWN" Then
        newPN = System.IO.Path.GetFileNameWithoutExtension(newFile)
    End If

    StoreConfiguratorComponentPartNumber(targetTitle, newPN)
    StoreConfiguratorComponentFilePath(targetTitle, newFile)

    Dim count As Integer = 0
    Dim oldParts As New System.Collections.Generic.List(Of String)

    ReplaceAllOccurrences(rootAsm.ComponentDefinition.Occurrences, targetTitle, newFile, count, oldParts)

    If count > 0 Then
        anySwap = True
        swapReport &= targetTitle & " : " & BuildUniqueList(oldParts) & " -> " & newPN & " (Qty: " & count & ")" & vbCrLf
    Else
        swapReport &= targetTitle & " : File ready, but component not currently placed" & vbCrLf
    End If

End Sub

'====================================================
' GET FILE BY CRITERIA OR CREATE NEW
'====================================================
Function FindFileByCriteriaOrCreateNew( _
    ByVal rootAsm As AssemblyDocument, _
    ByVal targetTitle As String, _
    ByVal searchParams As System.Collections.Generic.Dictionary(Of String, String), _
    ByVal fallbackSourceFile As String, _
    ByRef swapReport As String) As String

    Dim cleanTitle As String = CleanRequiredComponentTitle(targetTitle)

    Dim foundFile As String = GetFileBySearchCriteriaWithWildcards(searchParams)

    If Trim(foundFile) <> "" Then
        StoreFoundVaultFile(cleanTitle, foundFile)
        Return foundFile
    End If

    Dim sourceFile As String = fallbackSourceFile

    If Trim(sourceFile) = "" Then
        sourceFile = FindFirstOccurrenceFileByTitle(rootAsm.ComponentDefinition.Occurrences, targetTitle)
    End If

    If Trim(sourceFile) = "" Then
        swapReport &= targetTitle & " : No Vault match, and no source file found to copy from" & vbCrLf
        Return ""
    End If

    If HasNewPartInput(cleanTitle) Then

        Dim inputPN As String = GetNewPartInputPN(cleanTitle)
        Dim inputPath As String = GetNewPartInputPath(cleanTitle)

        Dim createdFile As String = SaveAsWithProvidedPath(sourceFile, inputPN, inputPath, swapReport, cleanTitle)

        If Trim(createdFile) <> "" Then
            StoreConfiguratorComponentPartNumber(cleanTitle, inputPN)
            StoreConfiguratorComponentFilePath(cleanTitle, createdFile)
            Return createdFile
        End If

        Return ""

    End If

    If IsRequiredSearchComponent(cleanTitle) Then
        swapReport &= cleanTitle & " : Required component was not found in Vault and no form New PN / Save Location was provided." & vbCrLf
        SetStopFlag(cleanTitle & " : Required component was not found in Vault and no form New PN / Save Location was provided.")
        Return ""
    End If

    swapReport &= cleanTitle & " : No Vault match found and no form New PN / Save Location was provided. Skipped." & vbCrLf
    Return ""

End Function




'====================================================
' SAVE CURRENT TOP ASSEMBLY AS NEW DRIVE ASSY
'====================================================
' This version does NOT convert the active/running document.
'
' It creates a copy, opens that copy as a new document,
' then the configurator continues against the opened copy.
'
' This avoids the Vault Unknown Status issue caused by
' running the rule from the same document that was SaveAs'd.
'====================================================
Function SaveCurrentAssemblyAsNewDriveAssy( _
    ByVal sourceAsmDoc As AssemblyDocument, _
    ByVal newPN As String, _
    ByRef swapReport As String, _
    ByRef newDriveAssyFile As String, _
    ByRef newDriveAssyDoc As AssemblyDocument) As Boolean

    Try

        If sourceAsmDoc Is Nothing Then Return False

        Dim currentFile As String = sourceAsmDoc.FullFileName
        Dim ext As String = System.IO.Path.GetExtension(currentFile)
        Dim currentFolder As String = System.IO.Path.GetDirectoryName(currentFile)
        Dim suggestedFile As String = newPN & ext

        Dim newFile As String = GetNewPartInputPath("DRIVE ASSEMBLY")

        If Trim(newFile) = "" Then
            newFile = PromptForInventorSavePath("DRIVE ASSEMBLY", currentFolder, suggestedFile, ext)
        End If

        If Trim(newFile) = "" Then
            swapReport &= "DRIVE ASSEMBLY : Save As cancelled by user" & vbCrLf & vbCrLf
            Return False
        End If

        If LCase(Trim(currentFile)) = LCase(Trim(newFile)) Then
            MsgBox("The selected file name is the same as the current assembly." & vbCrLf & _
                   "Choose a different file name.", vbExclamation, "Invalid Save Location")
            Return False
        End If

        If System.IO.File.Exists(newFile) Then
            MsgBox("File already exists:" & vbCrLf & newFile & vbCrLf & vbCrLf & _
                   "Choose a different file name or location.", vbExclamation, "File Already Exists")
            Return False
        End If

        '====================================================
        ' SAVE COPY AS
        ' This keeps the original/running document untouched.
        '====================================================
        sourceAsmDoc.SaveAs(newFile, True)

        newDriveAssyFile = newFile

        '====================================================
        ' OPEN THE NEW DRIVE ASSY AS THE WORKING DOCUMENT
        '====================================================
        Dim openedDoc As Document = Nothing

        openedDoc = GetOpenDocumentByFullFileName(newFile)

        If openedDoc Is Nothing Then
            openedDoc = ThisApplication.Documents.Open(newFile, True)
        End If

        If openedDoc Is Nothing Then
            Return False
        End If

		newDriveAssyDoc = CType(openedDoc, AssemblyDocument)
		
		Try
		    newDriveAssyDoc.Activate()
		Catch
		End Try
		
		'====================================================
		' STORE NEW DRIVE ASSY PATH FOR RUNS CONFIGURATOR
		'====================================================
		Try
		    SharedVariable("DriveConfig_NewDriveAssyPath") = newDriveAssyDoc.FullFileName
		Catch
		End Try

        ApplyPartNumberAndGeneratedDescription(newDriveAssyDoc, "DRIVE ASSEMBLY", newPN)

        Try
            newDriveAssyDoc.Update2(True)
        Catch
            Try
                newDriveAssyDoc.Update()
            Catch
            End Try
        End Try

        Try
            newDriveAssyDoc.Save2(True)
        Catch
            Try
                newDriveAssyDoc.Save()
            Catch
            End Try
        End Try

        StoreConfiguratorComponentPartNumber("DRIVE ASSEMBLY", newPN)
        StoreConfiguratorComponentFilePath("DRIVE ASSEMBLY", newFile)

        swapReport &= "DRIVE ASSEMBLY : Top assembly copied as [" & newPN & "] at [" & newFile & "]" & vbCrLf & vbCrLf

        Return True

    Catch ex As Exception

        MsgBox("Top-level DRIVE ASSEMBLY copy failed for [" & newPN & "]" & vbCrLf & vbCrLf & _
               ex.Message, vbCritical, "Save Copy As Failed")

        Return False

    End Try

End Function



'====================================================
' SAVE AS WITH PROVIDED PATH FROM FORM
'====================================================
Function SaveAsWithProvidedPath( _
    ByVal sourceFile As String, _
    ByVal newPN As String, _
    ByVal newFile As String, _
    ByRef swapReport As String, _
    ByVal targetLabel As String) As String

    If Trim(sourceFile) = "" Then
        swapReport &= targetLabel & " : No source file provided for Save As" & vbCrLf
        Return ""
    End If

    If Trim(newPN) = "" Then
        swapReport &= targetLabel & " : New part number was blank" & vbCrLf
        Return ""
    End If

    If Trim(newFile) = "" Then
        swapReport &= targetLabel & " : Save location was blank" & vbCrLf
        Return ""
    End If

    Return SaveAsCore(sourceFile, newPN, newFile, swapReport, targetLabel)

End Function


'====================================================
' SAVE AS CORE
'====================================================
' Copies the source file to a new file path.
'
' IMPORTANT:
'   This version does NOT open the newly created file.
'
' Workflow:
'   1. Open source/template file invisibly
'   2. Save Copy As new file
'   3. Close source/template file
'   4. Store pending Part Number / Description task
'   5. Store drawing task
'   6. Store created child file path
'   7. Return new file path for occurrence replacement
'
' Later:
'   ProcessCreatedPropertyTasks() opens the created files,
'   writes Part Number and Description, saves them, and
'   leaves them open.
'
' Existing Vault files are never modified.
'====================================================
Function SaveAsCore( _
    ByVal sourceFile As String, _
    ByVal newPN As String, _
    ByVal newFile As String, _
    ByRef swapReport As String, _
    ByVal targetLabel As String) As String

    Dim sourceDoc As Document = Nothing

    Try

        '====================================================
        ' VALIDATION
        '====================================================
        If Trim(sourceFile) = "" Then
            swapReport &= targetLabel & " : Source file was blank" & vbCrLf
            Return ""
        End If

        If Not System.IO.File.Exists(sourceFile) Then
            swapReport &= targetLabel & " : Source file not found [" & sourceFile & "]" & vbCrLf
            Return ""
        End If

        If Trim(newPN) = "" Then
            swapReport &= targetLabel & " : New part number was blank" & vbCrLf
            Return ""
        End If

        If Trim(newFile) = "" Then
            swapReport &= targetLabel & " : Save location was blank" & vbCrLf
            Return ""
        End If

        If LCase(Trim(sourceFile)) = LCase(Trim(newFile)) Then
            swapReport &= targetLabel & " : Save location matches source file. Skipped." & vbCrLf
            Return ""
        End If

        If System.IO.File.Exists(newFile) Then
            swapReport &= targetLabel & " : File already exists [" & newFile & "]" & vbCrLf
            Return ""
        End If

        '====================================================
        ' CREATE COPY ONLY
        '
        ' This creates the new file but does not open it.
        '====================================================
        sourceDoc = ThisApplication.Documents.Open(sourceFile, False)

        sourceDoc.SaveAs(newFile, True)

        Try
            sourceDoc.Close(False)
        Catch
        End Try

        sourceDoc = Nothing

        If Not System.IO.File.Exists(newFile) Then
            swapReport &= targetLabel & " : Save Copy As did not create file [" & newFile & "]" & vbCrLf
            Return ""
        End If

        '====================================================
        ' STORE PENDING PROPERTY WRITE
        '
        ' PN and Description are written after replacements.
        '====================================================
        StoreCreatedPropertyTask(targetLabel, newFile, newPN)

        '====================================================
        ' STORE DRAWING TASK FOR LATER
        '
        ' Drawings should be created after replacement and
        ' after properties have been written.
        '====================================================
        StoreCreatedDrawingTask(targetLabel, newFile, sourceFile)

        '====================================================
        ' TRACK CREATED FILE
        '====================================================
        StoreCreatedChildFile(newFile)

        swapReport &= _
            targetLabel & _
            " : No Vault match, created new file [" & _
            newPN & _
            "] at [" & _
            newFile & _
            "]" & _
            vbCrLf

        Return newFile

    Catch ex As Exception

        MsgBox( _
            "Save As failed for [" & targetLabel & "]" & vbCrLf & vbCrLf & _
            "Part Number: " & newPN & vbCrLf & _
            "Path: " & newFile & vbCrLf & vbCrLf & _
            ex.Message, _
            vbCritical, _
            "Save As Failed")

        Return ""

    Finally

        Try
            If Not sourceDoc Is Nothing Then
                sourceDoc.Close(False)
            End If
        Catch
        End Try

    End Try

End Function

'====================================================
' APPLY PART NUMBER AND GENERATED DESCRIPTION
'====================================================
' Only used on NEW files.
' Existing Vault files are never modified.
'====================================================
Sub ApplyPartNumberAndGeneratedDescription( _
    ByVal oDoc As Document, _
    ByVal componentName As String, _
    ByVal newPN As String)

    If oDoc Is Nothing Then Exit Sub

    Try

        oDoc.PropertySets.Item( _
            "Design Tracking Properties") _
            .Item("Part Number").Value = _
            Trim(newPN)

    Catch
    End Try

    Dim generatedDesc As String = _
        GetGeneratedDescriptionFromSharedVariable( _
            componentName)

    If Trim(generatedDesc) <> "" Then

        Try

            oDoc.PropertySets.Item( _
                "Design Tracking Properties") _
                .Item("Description").Value = _
                generatedDesc

        Catch
        End Try

    End If

    'Do not save here.
    'The caller updates and saves the document.

End Sub


'====================================================
' GENERATED DESCRIPTION FROM SHARED VARIABLE
'====================================================
Function GetGeneratedDescriptionFromSharedVariable(ByVal componentName As String) As String

    Try
        Dim key As String = GetConfiguratorComponentKey(componentName)

        If SharedVariable.Exists("DriveConfig_DESC_" & key) Then
            Return Trim(CStr(SharedVariable("DriveConfig_DESC_" & key)))
        End If

    Catch
    End Try

    Return ""

End Function


'====================================================
' VAULT SEARCH WITH WILDCARDS
'
' TITLE and CATEGORY NAME use exact matching.
'
' All other properties use wildcard matching so Vault
' can match formatted parameter/property values.
'
' Because NewCriteria() always includes:
'     Category Name = MOBILE
'
' every Vault search in this rule is restricted to the
' MOBILE category.
'====================================================
Function GetFileBySearchCriteriaWithWildcards( _
    ByVal searchCriteria As System.Collections.Generic.Dictionary(Of String, String)) As String

    Try

        If searchCriteria Is Nothing Then Return ""

        Dim searchToUse As New System.Collections.Generic.Dictionary(Of String, String)

        For Each kvp As System.Collections.Generic.KeyValuePair(Of String, String) In searchCriteria

            Dim keyText As String = Trim(kvp.Key)
            Dim valueText As String = Trim(kvp.Value)
            Dim upperKey As String = UCase(keyText)

            '====================================================
            ' EXACT MATCH PROPERTIES
            '====================================================
            If upperKey = "TITLE" OrElse _
               upperKey = "CATEGORY NAME" Then

                searchToUse.Add(keyText, valueText)

            '====================================================
            ' BLANK VALUES
            '====================================================
            ElseIf valueText = "" Then

                searchToUse.Add(keyText, valueText)

            '====================================================
            ' VALUE ALREADY HAS WILDCARDS
            '====================================================
            ElseIf Left(valueText, 1) = "*" AndAlso _
                   Right(valueText, 1) = "*" Then

                searchToUse.Add(keyText, valueText)

            '====================================================
            ' STANDARD WILDCARD SEARCH
            '====================================================
            Else

                searchToUse.Add(keyText, "*" & valueText & "*")

            End If

        Next

        Dim foundFile As String = _
            iLogicVault.GetFileBySearchCriteria( _
                searchToUse, _
                True, _
                False)

        If Trim(foundFile) = "" Then Return ""

        Dim ext As String = _
            LCase(System.IO.Path.GetExtension(foundFile))

        Select Case ext

            Case ".ipt", ".iam"
                Return foundFile

			Case ".idw", ".dwg", ".ipn"
			
			    Dim baseName As String = _
			        System.IO.Path.GetFileNameWithoutExtension( _
			            foundFile)
			
			    Dim folder As String = _
			        System.IO.Path.GetDirectoryName( _
			            foundFile)
			
			    Dim iptFile As String = _
			        System.IO.Path.Combine(folder, baseName & ".ipt")
			
			    Dim iamFile As String = _
			        System.IO.Path.Combine(folder, baseName & ".iam")
			
			    If System.IO.File.Exists(iptFile) Then
			        Return iptFile
			    End If
			
			    If System.IO.File.Exists(iamFile) Then
			        Return iamFile
			    End If
			
			    Return ""


            Case Else

                MsgBox( _
                    "Vault returned an unsupported file type:" & _
                    vbCrLf & vbCrLf & _
                    foundFile, _
                    vbExclamation, _
                    "Vault Search Result")

                Return ""

        End Select

    Catch

        Return ""

    End Try

End Function


'====================================================
' INVENTOR SAVE DIALOG
'====================================================
Function PromptForInventorSavePath( _
    ByVal targetLabel As String, _
    ByVal initialFolder As String, _
    ByVal suggestedFileName As String, _
    ByVal ext As String) As String

    Dim dlg As Inventor.FileDialog = Nothing

    Try

        ThisApplication.CreateFileDialog(dlg)

        dlg.DialogTitle = "Save New File For " & targetLabel
        dlg.InitialDirectory = initialFolder
        dlg.FileName = suggestedFileName
        dlg.CancelError = True

        If LCase(ext) = ".ipt" Then
            dlg.Filter = "Inventor Part Files (*.ipt)|*.ipt"
        ElseIf LCase(ext) = ".iam" Then
            dlg.Filter = "Inventor Assembly Files (*.iam)|*.iam"
        Else
            dlg.Filter = "Matching Files (*" & ext & ")|*" & ext
        End If

        Try
            dlg.ShowSave()
            Return dlg.FileName
        Catch
            Return ""
        End Try

    Catch
        Return ""
    End Try

End Function


'====================================================
' CREATE DRIVE GENERATOR DRAWING
'====================================================
Sub CreateDriveGeneratorDrawing( _
    ByVal oModelDoc As Document, _
    ByVal targetLabel As String, _
    ByRef swapReport As String, _
    Optional ByVal templateSourceFile As String = "")

    If oModelDoc Is Nothing Then Exit Sub

    If oModelDoc.DocumentType <> DocumentTypeEnum.kPartDocumentObject And _
       oModelDoc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then
        Exit Sub
    End If

    Dim modelFile As String = ""

    Try
        modelFile = oModelDoc.FullFileName
    Catch
        Exit Sub
    End Try

    If Trim(modelFile) = "" Then Exit Sub
    If Not System.IO.File.Exists(modelFile) Then Exit Sub

    Dim modelPN As String = GetDocumentPartNumber(oModelDoc)

    If Trim(modelPN) = "" Then
        modelPN = System.IO.Path.GetFileNameWithoutExtension(modelFile)
    End If

	Dim templatePath As String = ""
	
	If Trim(templateSourceFile) <> "" Then
	    templatePath = System.IO.Path.ChangeExtension(templateSourceFile, ".idw")
	End If
	
	If Trim(templatePath) = "" Then
	    templatePath = GetDrawingTemplatePath(targetLabel)
	End If

	If Trim(templatePath) = "" Then
	    swapReport &= "DRAWING : No template path found for [" & targetLabel & "]" & vbCrLf
	    Exit Sub
	End If

    If Not System.IO.File.Exists(templatePath) Then
        swapReport &= "DRAWING : Template not found for [" & targetLabel & "] - [" & templatePath & "]" & vbCrLf
        Exit Sub
    End If

    Dim drawingFile As String = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(modelFile), modelPN & ".idw")

    If System.IO.File.Exists(drawingFile) Then
        swapReport &= "DRAWING : Already exists [" & modelPN & ".idw]" & vbCrLf
        Exit Sub
    End If

    Dim oDraw As DrawingDocument = Nothing

    Try

        oDraw = CType(ThisApplication.Documents.Open(templatePath, False), DrawingDocument)
        oDraw.SaveAs(drawingFile, False)

        Dim replaced As Integer = 0

        For Each fd As FileDescriptor In oDraw.File.ReferencedFileDescriptors
            Try
                Dim refFile As String = fd.FullFileName
                Dim refExt As String = LCase(System.IO.Path.GetExtension(refFile))

                If refExt = ".ipt" Or refExt = ".iam" Then
                    fd.ReplaceReference(modelFile)
                    replaced += 1
                End If
            Catch
            End Try
        Next

        Try
            oDraw.Update()
        Catch
        End Try

        Try
            oDraw.Save2(True)
        Catch
            oDraw.Save()
        End Try

        If replaced = 0 Then
            swapReport &= "DRAWING : Created [" & modelPN & ".idw], but no model reference was replaced" & vbCrLf
        Else
            swapReport &= "DRAWING : Created [" & modelPN & ".idw] from template [" & System.IO.Path.GetFileName(templatePath) & "]" & vbCrLf
        End If

    Catch ex As Exception

        swapReport &= "DRAWING : Failed [" & modelPN & "] - " & ex.Message & vbCrLf

    Finally

        Try
            If Not oDraw Is Nothing Then oDraw.Close(True)
        Catch
        End Try

    End Try

End Sub



'====================================================
' DRAWING TEMPLATE PATH
'
' Uses the source file currently in the assembly.
'====================================================
Function GetDrawingTemplatePath(ByVal targetLabel As String) As String

    Dim sourceFile As String = ""

    Select Case UCase(Trim(targetLabel))

        Case "DRIVE ASSEMBLY"
            sourceFile = GetBestInitialSourceFile("DRIVE ASSEMBLY", "", True)

        Case "DRIVE FRAME"
            sourceFile = GetBestInitialSourceFile("DRIVE FRAME", "", False)

        Case "CYLINDER MOUNT"
            sourceFile = GetBestInitialSourceFile("CYLINDER MOUNT", "", False)

        Case "CYLINDER MOUNT ASSEMBLY"
            sourceFile = GetBestInitialSourceFile("CYLINDER MOUNT ASSEMBLY", "", False)

        Case "STIFFENER"
            sourceFile = GetBestInitialSourceFile("STIFFENER", "", False)

        Case "CROSSMEMBER"
            sourceFile = GetBestInitialSourceFile("CROSSMEMBER", "", False)

        Case Else
            Return ""

    End Select

    If Trim(sourceFile) = "" Then Return ""

    Return System.IO.Path.ChangeExtension(sourceFile, ".idw")

End Function

'====================================================
' REPLACE ALL OCCURRENCES BY TITLE
'
' Safer version:
'   1. Collects matching occurrences first.
'   2. Replaces after collection is complete.
'
' Do not update/save subassemblies inside recursion.
'====================================================
Sub ReplaceAllOccurrences( _
    ByVal occs As ComponentOccurrences, _
    ByVal targetTitle As String, _
    ByVal newFile As String, _
    ByRef count As Integer, _
    ByRef oldParts As System.Collections.Generic.List(Of String))

    If occs Is Nothing Then Exit Sub
    If Trim(targetTitle) = "" Then Exit Sub
    If Trim(newFile) = "" Then Exit Sub

    Dim matches As New System.Collections.Generic.List(Of ComponentOccurrence)
    Dim visitedDocs As New System.Collections.Generic.Dictionary(Of String, Boolean)

    CollectOccurrencesByTitle( _
        occs, _
        targetTitle, _
        matches, _
        visitedDocs)

    For Each occ As ComponentOccurrence In matches

        Try

            oldParts.Add(GetOccurrencePartNumber(occ))

			'Use False here because this rule already collected every matching occurrence.
			'This still replaces all matches through the loop, but avoids Inventor's internal
			'replace-all behavior fighting the manual recursive loop.
			occ.Replace(newFile, False)

            count += 1

        Catch ex As Exception

            MsgBox( _
                "Replace failed" & vbCrLf & vbCrLf & _
                "Target Title: " & targetTitle & vbCrLf & _
                "Occurrence Title: " & GetOccurrenceTitle(occ) & vbCrLf & _
                "Current File: " & GetOccurrenceFilePath(occ) & vbCrLf & _
                "New File: " & newFile & vbCrLf & vbCrLf & _
                ex.Message, _
                vbCritical, _
                "Replace Error")

        End Try

    Next

End Sub



'====================================================
' COLLECT OCCURRENCES BY TITLE
'
' Recursively searches real subassembly documents.
' Does not replace, update, or save anything.
'====================================================
Sub CollectOccurrencesByTitle( _
    ByVal occs As ComponentOccurrences, _
    ByVal targetTitle As String, _
    ByVal matches As System.Collections.Generic.List(Of ComponentOccurrence), _
    ByVal visitedDocs As System.Collections.Generic.Dictionary(Of String, Boolean))

    If occs Is Nothing Then Exit Sub

    For Each occ As ComponentOccurrence In occs

        Try

            If StringsEqual(GetOccurrenceTitle(occ), targetTitle) Then
                matches.Add(occ)
            End If

            If TypeOf occ.Definition.Document Is AssemblyDocument Then

                Dim subAsm As AssemblyDocument = _
                    CType(occ.Definition.Document, AssemblyDocument)

                Dim docKey As String = GetDocumentUniqueKey(subAsm)

                If Trim(docKey) <> "" Then

                    If Not visitedDocs.ContainsKey(docKey) Then

                        visitedDocs.Add(docKey, True)

                        CollectOccurrencesByTitle( _
                            subAsm.ComponentDefinition.Occurrences, _
                            targetTitle, _
                            matches, _
                            visitedDocs)

                    End If

                End If

            End If

        Catch
        End Try

    Next

End Sub


'====================================================
' DOCUMENT UNIQUE KEY
'
' Prevents recursive loops and repeated traversal.
'====================================================
Function GetDocumentUniqueKey(ByVal doc As Document) As String

    If doc Is Nothing Then Return ""

    Try
        If Trim(doc.FullFileName) <> "" Then
            Return UCase(Trim(doc.FullFileName))
        End If
    Catch
    End Try

    Try
        Return UCase(Trim(doc.DisplayName))
    Catch
    End Try

    Return ""

End Function



'====================================================
' FIND FIRST OCCURRENCE FILE BY TITLE
'
' Safe recursive version with visited document tracking.
'====================================================
Function FindFirstOccurrenceFileByTitle( _
    ByVal occs As ComponentOccurrences, _
    ByVal targetTitle As String) As String

    Dim visitedDocs As New System.Collections.Generic.Dictionary(Of String, Boolean)

    Return FindFirstOccurrenceFileByTitleCore( _
        occs, _
        targetTitle, _
        visitedDocs)

End Function


Function FindFirstOccurrenceFileByTitleCore( _
    ByVal occs As ComponentOccurrences, _
    ByVal targetTitle As String, _
    ByVal visitedDocs As System.Collections.Generic.Dictionary(Of String, Boolean)) As String

    If occs Is Nothing Then Return ""

    For Each occ As ComponentOccurrence In occs

        Try

            If StringsEqual(GetOccurrenceTitle(occ), targetTitle) Then
                Return GetOccurrenceFilePath(occ)
            End If

            If TypeOf occ.Definition.Document Is AssemblyDocument Then

                Dim subAsm As AssemblyDocument = _
                    CType(occ.Definition.Document, AssemblyDocument)

                Dim docKey As String = GetDocumentUniqueKey(subAsm)

                If Trim(docKey) <> "" Then

                    If Not visitedDocs.ContainsKey(docKey) Then

                        visitedDocs.Add(docKey, True)

                        Dim nestedFile As String = _
                            FindFirstOccurrenceFileByTitleCore( _
                                subAsm.ComponentDefinition.Occurrences, _
                                targetTitle, _
                                visitedDocs)

                        If Trim(nestedFile) <> "" Then Return nestedFile

                    End If

                End If

            End If

        Catch
        End Try

    Next

    Return ""

End Function


'====================================================
' FIND FIRST CHILD FILE INSIDE PARENT BY TITLE
'
' Safe recursive version with visited document tracking.
'====================================================
Function FindFirstChildOccurrenceFileInsideParent( _
    ByVal occs As ComponentOccurrences, _
    ByVal parentTitle As String, _
    ByVal childTitle As String) As String

    Dim visitedDocs As New System.Collections.Generic.Dictionary(Of String, Boolean)

    Return FindFirstChildOccurrenceFileInsideParentCore( _
        occs, _
        parentTitle, _
        childTitle, _
        visitedDocs)

End Function


Function FindFirstChildOccurrenceFileInsideParentCore( _
    ByVal occs As ComponentOccurrences, _
    ByVal parentTitle As String, _
    ByVal childTitle As String, _
    ByVal visitedDocs As System.Collections.Generic.Dictionary(Of String, Boolean)) As String

    If occs Is Nothing Then Return ""

    For Each occ As ComponentOccurrence In occs

        Try

            If StringsEqual(GetOccurrenceTitle(occ), parentTitle) Then

                If TypeOf occ.Definition.Document Is AssemblyDocument Then

                    Dim parentAsm As AssemblyDocument = _
                        CType(occ.Definition.Document, AssemblyDocument)

                    Dim childFile As String = _
                        FindFirstOccurrenceFileByTitle( _
                            parentAsm.ComponentDefinition.Occurrences, _
                            childTitle)

                    If Trim(childFile) <> "" Then Return childFile

                End If

            End If

            If TypeOf occ.Definition.Document Is AssemblyDocument Then

                Dim subAsm As AssemblyDocument = _
                    CType(occ.Definition.Document, AssemblyDocument)

                Dim docKey As String = GetDocumentUniqueKey(subAsm)

                If Trim(docKey) <> "" Then

                    If Not visitedDocs.ContainsKey(docKey) Then

                        visitedDocs.Add(docKey, True)

                        Dim nestedFile As String = _
                            FindFirstChildOccurrenceFileInsideParentCore( _
                                subAsm.ComponentDefinition.Occurrences, _
                                parentTitle, _
                                childTitle, _
                                visitedDocs)

                        If Trim(nestedFile) <> "" Then Return nestedFile

                    End If

                End If

            End If

        Catch
        End Try

    Next

    Return ""

End Function


'====================================================
' SHARED VARIABLE STORAGE
'====================================================
Sub ResetSearchResultSharedVariables()

    Try

			SharedVariable("DriveConfig_StopAfterSearch") = False
			SharedVariable("DriveConfig_StopReason") = ""
			SharedVariable("DriveConfig_NewDriveAssyPath") = ""
			SharedVariable("DriveConfig_CreatedChildFiles") = ""
			SharedVariable("DriveConfig_CreatedDrawingTasks") = ""
			SharedVariable("DriveConfig_CreatedPropertyTasks") = ""

        Dim keys() As String = New String() { _
            "DRIVE_ASSEMBLY", _
            "CROSSMEMBER", _
            "DRIVE_CORE", _
            "CROSS_DRIVE_SET", _
            "UPPER_CROSS_DRIVE_SUPPORT", _
            "SERIAL_PLATE", _
            "CYLINDER_MOUNT", _
            "STIFFENER", _
            "DRIVE_FRAME", _
            "CYLINDER_MOUNT_ASSEMBLY" _
        }

        For Each key As String In keys

            SharedVariable("DriveConfig_PN_" & key) = ""
            SharedVariable("DriveConfig_FILE_" & key) = ""

            'Do NOT clear DriveConfig_DESC_* here.
            'The Generate Description rule owns descriptions.

        Next

    Catch
    End Try

End Sub


Sub StoreFoundVaultFile( _
    ByVal componentName As String, _
    ByVal filePath As String)

    StoreConfiguratorComponentPartNumber(componentName, GetPartNumber(filePath))
    StoreConfiguratorComponentFilePath(componentName, filePath)

End Sub


Sub StoreConfiguratorComponentPartNumber( _
    ByVal componentName As String, _
    ByVal partNumber As String)

    Try
        Dim key As String = GetConfiguratorComponentKey(componentName)
        SharedVariable("DriveConfig_PN_" & key) = Trim(partNumber)
    Catch
    End Try

End Sub


Sub StoreConfiguratorComponentFilePath( _
    ByVal componentName As String, _
    ByVal filePath As String)

    Try
        Dim key As String = GetConfiguratorComponentKey(componentName)
        SharedVariable("DriveConfig_FILE_" & key) = Trim(filePath)
    Catch
    End Try

End Sub


Function GetNewPartInputPN(ByVal componentName As String) As String

    Try
        Dim key As String = GetConfiguratorComponentKey(componentName)

        If SharedVariable.Exists("DriveConfig_InputPN_" & key) Then
            Return CStr(SharedVariable("DriveConfig_InputPN_" & key))
        End If

    Catch
    End Try

    Return ""

End Function


Function GetNewPartInputPath(ByVal componentName As String) As String

    Try
        Dim key As String = GetConfiguratorComponentKey(componentName)

        If SharedVariable.Exists("DriveConfig_InputPath_" & key) Then
            Return CStr(SharedVariable("DriveConfig_InputPath_" & key))
        End If

    Catch
    End Try

    Return ""

End Function


Function HasNewPartInput(ByVal componentName As String) As Boolean

    Return Trim(GetNewPartInputPN(componentName)) <> "" And _
           Trim(GetNewPartInputPath(componentName)) <> ""

End Function


'====================================================
' COMPONENT KEY
'====================================================
Function GetConfiguratorComponentKey(ByVal componentName As String) As String

    Dim key As String = UCase(Trim(componentName))

    If InStr(key, "DRIVE ASSEMBLY") > 0 Then Return "DRIVE_ASSEMBLY"
    If InStr(key, "DRIVE CORE") > 0 Then Return "DRIVE_CORE"
    If InStr(key, "UPPER CROSS DRIVE SUPPORT") > 0 Then Return "UPPER_CROSS_DRIVE_SUPPORT"
    If InStr(key, "CROSS DRIVE SET") > 0 Then Return "CROSS_DRIVE_SET"
    If InStr(key, "SERIAL PLATE") > 0 Then Return "SERIAL_PLATE"
    If InStr(key, "CYLINDER MOUNT ASSEMBLY") > 0 Then Return "CYLINDER_MOUNT_ASSEMBLY"
    If InStr(key, "CYLINDER MOUNT") > 0 Then Return "CYLINDER_MOUNT"
    If InStr(key, "DRIVE FRAME") > 0 Then Return "DRIVE_FRAME"
    If InStr(key, "STIFFENER") > 0 Then Return "STIFFENER"
    If InStr(key, "CROSSMEMBER") > 0 Then Return "CROSSMEMBER"

    Return Replace(key, " ", "_")

End Function


'====================================================
' GENERAL HELPERS
'====================================================
Function GetP( _
    ByVal p As System.Collections.Generic.Dictionary(Of String, String), _
    ByVal key As String) As String

    Try
        If p.ContainsKey(key) Then Return Trim(p.Item(key))
    Catch
    End Try

    Return ""

End Function


'====================================================
' SAFE iPROPERTY / PARAMETER READ
'====================================================
' Used by the Vault search builders.
'
' For TEXT / BOOLEAN parameters:
'   Uses the parameter value.
'
' For numeric / unit parameters:
'   Uses the exported Custom iProperty first.
'
' This is important because:
'
'   Parameter Expression may be:
'       60 in
'       40 in
'
'   Exported Custom iProperty may be:
'       60.0 in
'       40.0 in
'
' Vault is matching the exported Custom iProperty value.
'====================================================

Function SafeiProp(ByVal propName As String) As String

    Try

        Dim rawDoc As Document = ThisDoc.Document

        If rawDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then

            Dim asmDoc As AssemblyDocument = CType(rawDoc, AssemblyDocument)
            Dim userParams As UserParameters = asmDoc.ComponentDefinition.Parameters.UserParameters

            Dim oParam As UserParameter = Nothing

            Try
                oParam = userParams.Item(propName)
            Catch
                oParam = Nothing
            End Try

            If Not oParam Is Nothing Then

                Dim unitText As String = ""

                Try
                    unitText = UCase(Trim(CStr(oParam.Units)))
                Catch
                    unitText = ""
                End Try

                '====================================================
                ' TEXT / BOOLEAN PARAMETERS
                '====================================================

                If unitText = "TEXT" Or _
                   unitText = "BOOLEAN" Or _
                   unitText = "TRUE/FALSE" Then

                    Try
                        Return Trim(CStr(oParam.Value))
                    Catch
                        Return ""
                    End Try

                End If

                '====================================================
                ' NUMERIC / UNIT PARAMETERS
                '====================================================
                ' Read the exported Custom iProperty first.
                ' This is the formatted value Vault should match.
                '====================================================

                Try

                    Dim propSet As PropertySet = _
                        rawDoc.PropertySets.Item("Inventor User Defined Properties")

                    Dim propValue As String = _
                        Trim(CStr(propSet.Item(propName).Value))

                    If propValue <> "" Then
                        Return propValue
                    End If

                Catch
                End Try

                '====================================================
                ' FALLBACK TO PARAMETER EXPRESSION
                '====================================================

                Try
                    Return Trim(CStr(oParam.Expression))
                Catch
                    Return ""
                End Try

            End If

        End If

    Catch
    End Try

    '====================================================
    ' FINAL FALLBACK
    '====================================================
    ' Try reading the custom property directly.
    '====================================================

    Try

        Dim rawDoc As Document = ThisDoc.Document

        Dim propSet As PropertySet = _
            rawDoc.PropertySets.Item("Inventor User Defined Properties")

        Return Trim(CStr(propSet.Item(propName).Value))

    Catch
        Return ""
    End Try

End Function


Function GetMissingCriteriaText( _
    ByVal searchCriteria As System.Collections.Generic.Dictionary(Of String, String)) As String

    Dim result As String = ""

    If searchCriteria Is Nothing Then Return "[NO CRITERIA]"

    For Each kvp As System.Collections.Generic.KeyValuePair(Of String, String) In searchCriteria

        If Trim(kvp.Value) = "" Then

            If result <> "" Then result &= ", "
            result &= "[" & kvp.Key & "]"

        End If

    Next

    Return result

End Function


Sub AddMissingRequiredLine( _
    ByRef missingRequired As String, _
    ByVal lineText As String)

    If Trim(missingRequired) <> "" Then missingRequired &= vbCrLf
    missingRequired &= lineText

End Sub


Sub SetStopFlag(ByVal reason As String)

    Try
        SharedVariable("DriveConfig_StopAfterSearch") = True
        SharedVariable("DriveConfig_StopReason") = reason
    Catch
    End Try

End Sub


Function IsRequiredSearchComponent(ByVal targetTitle As String) As Boolean

    Dim key As String = UCase(Trim(targetTitle))

    If key = "PHANTOM CONTROLS ASSEMBLY" Then Return True
    If key = "CROSS DRIVE SET" Then Return True
    If key = "DRIVE CORE" Then Return True
    If key = "SERIAL PLATE" Then Return True
    If key = "UPPER CROSS DRIVE SUPPORT" Then Return True
    If key = "PHANTOM VALVE MOUNTS" Then Return True
    If key = "PHANTOM TIE TUBES" Then Return True

    Return False

End Function


Function CleanRequiredComponentTitle(ByVal targetLabel As String) As String

    Dim key As String = UCase(Trim(targetLabel))

    If InStr(key, "CROSS DRIVE SET") > 0 Then Return "CROSS DRIVE SET"
    If InStr(key, "DRIVE CORE") > 0 Then Return "DRIVE CORE"
    If InStr(key, "UPPER CROSS DRIVE SUPPORT") > 0 Then Return "UPPER CROSS DRIVE SUPPORT"
    If InStr(key, "PHANTOM VALVE MOUNTS") > 0 Then Return "PHANTOM VALVE MOUNTS"
    If InStr(key, "PHANTOM TIE TUBES") > 0 Then Return "PHANTOM TIE TUBES"
    If InStr(key, "SERIAL PLATE") > 0 Then Return "SERIAL PLATE"
    If InStr(key, "PHANTOM CONTROLS ASSEMBLY") > 0 Then Return "PHANTOM CONTROLS ASSEMBLY"

    Return Trim(targetLabel)

End Function




