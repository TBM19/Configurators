    AddCriteria(d, "CC", GetP(p, "CC"))
    AddCriteria(d, "Shoe Style", GetP(p, "Shoe_Style"))
    AddCriteria(d, "SC", GetP(p, "SC"))
    AddCriteria(d, "Quantity of Shoes", GetP(p, "Quantity_of_Shoes"))
    AddCriteria(d, "Drive Frame Style", GetP(p, "Drive_Frame_Style"))
    AddCriteria(d, "Drive Frame Gap", GetP(p, "Drive_Frame_Gap"))
    AddCriteria(d, "Outside Dimension", GetP(p, "Outside_Dimension"))
    AddCriteria(d, "Inside Dimension", GetP(p, "Inside_Dimension"))
    AddCriteria(d, "Crossmember Material", GetP(p, "Crossmember_Material"))
    AddCriteria(d, "Crossmember Height", GetP(p, "Crossmember_Height"))
    AddCriteria(d, "Crossmember Width", GetP(p, "Crossmember_Width"))
    AddCriteria(d, "Finish", GetP(p, "Finish"))
    AddCriteria(d, "Customer", GetP(p, "Customer"))
    'AddCriteria(d, "Customer Crossmember Height", GetP(p, "Customer_Crossmember_Height"))
    'AddCriteria(d, "Subframe", GetP(p, "Subframe"))
    'AddCriteria(d, "Subframe Width", GetP(p, "Subframe_Width"))
    Return d
End Function


