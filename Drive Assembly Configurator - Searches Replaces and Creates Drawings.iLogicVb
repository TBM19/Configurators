Function StringsEqual(ByVal a As String, ByVal b As String) As Boolean
    Return UCase(Trim(a)) = UCase(Trim(b))
End Function


Function GetOccurrenceTitle(ByVal occ As ComponentOccurrence) As String
    Try
        Return CStr(occ.Definition.Document.PropertySets.Item("Inventor Summary Information").Item("Title").Value)
    Catch
        Return ""
    End Try
End Function


Function GetDocumentTitle(ByVal doc As Document) As String
    Try
        Return CStr(doc.PropertySets.Item("Inventor Summary Information").Item("Title").Value)
    Catch
        Return ""
    End Try
End Function


Function GetOccurrencePartNumber(ByVal occ As ComponentOccurrence) As String
    Try
        Return CStr(occ.Definition.Document.PropertySets.Item("Design Tracking Properties").Item("Part Number").Value)
    Catch
        Return "UNKNOWN"
    End Try
End Function


Function GetOccurrenceFilePath(ByVal occ As ComponentOccurrence) As String
    Try
        Return occ.Definition.Document.FullFileName
    Catch
        Return ""
    End Try
End Function


Function GetOpenDocumentByFullFileName(ByVal filePath As String) As Document

    Try

        Dim cleanPath As String = LCase(Trim(filePath))

        For Each d As Document In ThisApplication.Documents

            Try
                If LCase(Trim(d.FullFileName)) = cleanPath Then
                    Return d
                End If
            Catch
            End Try

        Next

    Catch
    End Try

    Return Nothing

End Function


Function GetPartNumber(ByVal filePath As String) As String

    Dim doc As Document = Nothing
    Dim openedHere As Boolean = False

    Try

        If Trim(filePath) = "" Then Return "UNKNOWN"
        If Not System.IO.File.Exists(filePath) Then Return "UNKNOWN"

        doc = GetOpenDocumentByFullFileName(filePath)

        If doc Is Nothing Then
            doc = ThisApplication.Documents.Open(filePath, False)
            openedHere = True
        End If

        Return GetDocumentPartNumber(doc)

    Catch

        Return "UNKNOWN"

    Finally

        Try
            If openedHere And Not doc Is Nothing Then
                doc.Close(False)
            End If
        Catch
        End Try

    End Try

End Function


Function GetDocumentPartNumber(ByVal doc As Document) As String

    Try
        Return Trim(CStr(doc.PropertySets.Item("Design Tracking Properties").Item("Part Number").Value))
    Catch
        Return ""
    End Try

End Function


Function BuildUniqueList(ByVal lst As System.Collections.Generic.List(Of String)) As String

    If lst Is Nothing Then Return "UNKNOWN"
    If lst.Count = 0 Then Return "UNKNOWN"

    Dim seen As New System.Collections.Generic.Dictionary(Of String, Boolean)
    Dim result As String = ""

    For Each item As String In lst

        If Not seen.ContainsKey(item) Then

            seen.Add(item, True)

            If result <> "" Then result &= ", "
            result &= item

        End If

    Next

    Return result

End Function


Function GetBestInitialSourceFile( _
    ByVal targetTitle As String, _
    ByVal parentTitle As String, _
    ByVal allowActiveDoc As Boolean) As String

    If allowActiveDoc Then

        If StringsEqual(GetDocumentTitle(ThisDoc.Document), targetTitle) Then
            Try
                Return ThisDoc.Document.FullFileName
            Catch
            End Try
        End If

    End If

    Dim filePath As String = ""

    If Trim(parentTitle) <> "" Then
        filePath = FindFirstChildOccurrenceFileInsideParent(ThisDoc.Document.ComponentDefinition.Occurrences, parentTitle, targetTitle)
        If filePath <> "" Then Return filePath
    End If

    Return FindFirstOccurrenceFileByTitle(ThisDoc.Document.ComponentDefinition.Occurrences, targetTitle)

End Function


'====================================================
' ACTIVATE DOCUMENT FOR VAULT
'====================================================
Sub ActivateDocumentForVault(ByVal oDoc As Document)

    If oDoc Is Nothing Then Exit Sub

    Try
        oDoc.Activate()
    Catch
    End Try

    Try
        ThisApplication.ActiveView.Update()
    Catch
    End Try

End Sub


'====================================================
' STORE CREATED CHILD FILE
'
' Stores every child file created by SaveAsCore().
'
' Important:
'   - Stores the real file path, not uppercase path.
'   - Uses uppercase only for duplicate checking.
'   - Existing Vault files are never added.
'====================================================
Sub StoreCreatedChildFile(ByVal filePath As String)

    Try

        If Trim(filePath) = "" Then Exit Sub

        Dim existingList As String = ""

        Try
            existingList = CStr(SharedVariable("DriveConfig_CreatedChildFiles"))
        Catch
            existingList = ""
        End Try

        Dim cleanPath As String = Trim(filePath)
        Dim checkList As String = UCase(existingList)
        Dim checkPath As String = "|" & UCase(cleanPath) & "|"

        If InStr(checkList, checkPath) = 0 Then
            existingList &= "|" & cleanPath & "|"
        End If

        SharedVariable("DriveConfig_CreatedChildFiles") = existingList

    Catch
    End Try

End Sub


'====================================================
' GET CONFIGURED COMPONENT PART NUMBER
'
' Reads DriveConfig_PN_* for a component.
'====================================================
Function GetConfiguredComponentPartNumber(ByVal componentName As String) As String

    Try

        Dim key As String = GetConfiguratorComponentKey(componentName)

        If SharedVariable.Exists("DriveConfig_PN_" & key) Then
            Return Trim(CStr(SharedVariable("DriveConfig_PN_" & key)))
        End If

    Catch
    End Try

    Return ""

End Function

'====================================================
' STORE CREATED PROPERTY TASK
'
' Stores:
'   Target Label
'   New Model File
'   New Part Number
'
' Property writes happen later, after all replacements.
'====================================================
Sub StoreCreatedPropertyTask( _
    ByVal targetLabel As String, _
    ByVal newModelFile As String, _
    ByVal newPartNumber As String)

    Try

        If Trim(targetLabel) = "" Then Exit Sub
        If Trim(newModelFile) = "" Then Exit Sub
        If Trim(newPartNumber) = "" Then Exit Sub

        Dim existingList As String = ""

        Try
            existingList = CStr(SharedVariable("DriveConfig_CreatedPropertyTasks"))
        Catch
            existingList = ""
        End Try

        Dim rowSep As String = Chr(30)
        Dim colSep As String = Chr(31)

        Dim newRow As String = _
            Trim(targetLabel) & colSep & _
            Trim(newModelFile) & colSep & _
            Trim(newPartNumber)

        If InStr(existingList, newRow) = 0 Then

            If Trim(existingList) <> "" Then
                existingList &= rowSep
            End If

            existingList &= newRow

        End If

        SharedVariable("DriveConfig_CreatedPropertyTasks") = existingList

    Catch
    End Try

End Sub

'====================================================
' PROCESS CREATED PROPERTY TASKS
'
' Runs after Push Parameters.
'
' For every newly created model:
'   1. Gets the loaded document or opens it visibly.
'   2. Activates it to guarantee a document tab.
'   3. Writes Part Number and Description.
'   4. Updates the model.
'   5. Saves the model.
'====================================================
Sub ProcessCreatedPropertyTasks(ByRef swapReport As String)

    Try

        Dim taskList As String = ""

        Try

            If SharedVariable.Exists( _
                "DriveConfig_CreatedPropertyTasks") Then

                taskList = CStr( _
                    SharedVariable( _
                        "DriveConfig_CreatedPropertyTasks"))

            End If

        Catch

            taskList = ""

        End Try

        If Trim(taskList) = "" Then

            swapReport &= _
                "PROPERTIES : No created property tasks found." & _
                vbCrLf

            Exit Sub

        End If

        Dim rowSep As String = Chr(30)
        Dim colSep As String = Chr(31)

        Dim rows() As String = Split(taskList, rowSep)

        Dim processedPaths As New _
            System.Collections.Generic.Dictionary( _
                Of String, Boolean)

        For Each taskRow As String In Rows

            Try

                If Trim(taskRow) = "" Then Continue For

                Dim cols() As String = Split(taskRow, colSep)

                If UBound(cols) < 2 Then

                    swapReport &= _
                        "PROPERTIES : Invalid property task row." & _
                        vbCrLf

                    Continue For

                End If

                Dim targetLabel As String = Trim(cols(0))
                Dim newModelFile As String = Trim(cols(1))
                Dim newPartNumber As String = Trim(cols(2))

                If targetLabel = "" Then Continue For
                If newModelFile = "" Then Continue For
                If newPartNumber = "" Then Continue For

                Dim pathKey As String = UCase(newModelFile)

                If processedPaths.ContainsKey(pathKey) Then
                    Continue For
                End If

                processedPaths.Add(pathKey, True)

                If Not System.IO.File.Exists(newModelFile) Then

                    swapReport &= _
                        "PROPERTIES : File not found [" & _
                        newModelFile & _
                        "]" & _
                        vbCrLf

                    Continue For

                End If

                Dim modelDoc As Document = _
                    GetOpenDocumentByFullFileName(newModelFile)

                '====================================================
                ' OPEN VISIBLY IF NOT ALREADY LOADED
                '
                ' True is intentionally used for OpenVisible.
                '====================================================
                If modelDoc Is Nothing Then

                    modelDoc = _
                        ThisApplication.Documents.Open( _
                            newModelFile, _
                            False)

                End If

                If modelDoc Is Nothing Then

                    swapReport &= _
                        "PROPERTIES : Could not open [" & _
                        targetLabel & _
                        "] [" & _
                        newModelFile & _
                        "]" & _
                        vbCrLf

                    Continue For

                End If

                '====================================================
                ' WRITE NEW-FILE PROPERTIES
                '====================================================
                ApplyPartNumberAndGeneratedDescription( _
                    modelDoc, _
                    targetLabel, _
                    newPartNumber)

                '====================================================
                ' UPDATE MODEL
                '====================================================
                Try

                    If modelDoc.DocumentType = _
                        DocumentTypeEnum.kPartDocumentObject Then

                        CType( _
                            modelDoc, _
                            PartDocument).Update2(True)

                    ElseIf modelDoc.DocumentType = _
                        DocumentTypeEnum.kAssemblyDocumentObject Then

                        CType( _
                            modelDoc, _
                            AssemblyDocument).Update2(True)

                    End If

                Catch exUpdate As Exception

                    swapReport &= _
                        "PROPERTIES : Update warning [" & _
                        targetLabel & _
                        "] - " & _
                        exUpdate.Message & _
                        vbCrLf

                End Try

                '====================================================
                ' SAVE MODEL
                '====================================================
                Try

                    modelDoc.Save2(True)

                Catch

                    Try

                        modelDoc.Save()

                    Catch exSave As Exception

                        swapReport &= _
                            "PROPERTIES : Save warning [" & _
                            targetLabel & _
                            "] - " & _
                            exSave.Message & _
                            vbCrLf

                    End Try

                End Try

				swapReport &= _
				    "PROPERTIES : Wrote PN/Description [" & _
				    targetLabel & _
				    "] [" & _
				    newPartNumber & _
				    "]" & _
				    vbCrLf

                '====================================================
                ' DO NOT CLOSE modelDoc
                '====================================================

            Catch exRow As Exception

                swapReport &= _
                    "PROPERTIES : One property task failed - " & _
                    exRow.Message & _
                    vbCrLf

            End Try

        Next

    Catch ex As Exception

        swapReport &= _
            "PROPERTIES : ProcessCreatedPropertyTasks failed - " & _
            ex.Message & _
            vbCrLf

    End Try

End Sub

'====================================================
' STORE CREATED DRAWING TASK
'
' Stores:
'   Target Label
'   New Model File
'   Source Model File
'
' Drawing creation happens later, after all replacements.
'====================================================
Sub StoreCreatedDrawingTask( _
    ByVal targetLabel As String, _
    ByVal newModelFile As String, _
    ByVal sourceModelFile As String)

    Try

        If Trim(targetLabel) = "" Then Exit Sub
        If Trim(newModelFile) = "" Then Exit Sub
        If Trim(sourceModelFile) = "" Then Exit Sub

        Dim existingList As String = ""

        Try
            existingList = CStr(SharedVariable("DriveConfig_CreatedDrawingTasks"))
        Catch
            existingList = ""
        End Try

        Dim rowSep As String = Chr(30)
        Dim colSep As String = Chr(31)

        Dim newRow As String = _
            Trim(targetLabel) & colSep & _
            Trim(newModelFile) & colSep & _
            Trim(sourceModelFile)

        If InStr(existingList, newRow) = 0 Then

            If Trim(existingList) <> "" Then
                existingList &= rowSep
            End If

            existingList &= newRow

        End If

        SharedVariable("DriveConfig_CreatedDrawingTasks") = existingList

    Catch
    End Try

End Sub


'====================================================
' OPEN ALL CREATED MODEL FILES AND KEEP THEM OPEN
'
' This is the only routine that creates visible tabs
' for newly created child models.
'
' No created model is closed.
'====================================================
Sub OpenAllCreatedFilesAndKeepOpen( _
    ByRef swapReport As String)

    Dim createdList As String = ""

    Try

        If SharedVariable.Exists( _
            "DriveConfig_CreatedChildFiles") Then

            createdList = _
                CStr(SharedVariable( _
                    "DriveConfig_CreatedChildFiles"))

        End If

    Catch

        createdList = ""

    End Try

    If Trim(createdList) = "" Then

        swapReport &= _
            "OPEN FILES : No newly created child files." & _
            vbCrLf

        Exit Sub

    End If

    Dim fileItems() As String = _
        Split(createdList, "|")

    Dim processedPaths As New _
        System.Collections.Generic.Dictionary( _
            Of String, Boolean)

    Dim openedCount As Integer = 0

    For Each rawPath As String In fileItems

        Dim filePath As String = Trim(rawPath)

        If filePath = "" Then Continue For

        Try

            Dim pathKey As String = ""

            Try

                pathKey = _
                    UCase(System.IO.Path.GetFullPath( _
                        filePath))

            Catch

                pathKey = UCase(filePath)

            End Try

            If processedPaths.ContainsKey(pathKey) Then
                Continue For
            End If

            processedPaths.Add(pathKey, True)

            If Not System.IO.File.Exists(filePath) Then

                swapReport &= _
                    "OPEN FILES : File not found [" & _
                    filePath & _
                    "]" & _
                    vbCrLf

                Continue For

            End If

            Dim createdDoc As Document = _
                GetOpenDocumentByFullFileName( _
                    filePath)

            '================================================
            ' NOT LOADED:
            ' OpenVisible = True
            '================================================
            If createdDoc Is Nothing Then

                createdDoc = _
                    ThisApplication.Documents.Open( _
                        filePath, _
                        True)

            End If

            If createdDoc Is Nothing Then

                swapReport &= _
                    "OPEN FILES : Could not load [" & _
                    filePath & _
                    "]" & _
                    vbCrLf

                Continue For

            End If

            '================================================
            ' ALREADY REFERENCE-LOADED:
            ' Add a document view if no visible view exists.
            '================================================
            Try

                If createdDoc.Views.Count = 0 Then
                    createdDoc.Views.Add()
                End If

            Catch exView As Exception

                swapReport &= _
                    "OPEN FILES : View warning [" & _
                    createdDoc.DisplayName & _
                    "] - " & _
                    exView.Message & _
                    vbCrLf

            End Try

            '================================================
            ' ACTIVATE VISIBLE VIEW OR DOCUMENT
            '================================================
            Try

                If createdDoc.Views.Count > 0 Then

                    createdDoc.Views.Item(1).Visible = True
                    createdDoc.Views.Item(1).Activate()

                Else

                    createdDoc.Activate()

                End If

            Catch

                Try
                    createdDoc.Activate()
                Catch exActivate As Exception

                    swapReport &= _
                        "OPEN FILES : Activate warning [" & _
                        createdDoc.DisplayName & _
                        "] - " & _
                        exActivate.Message & _
                        vbCrLf

                End Try

            End Try

            openedCount += 1

            swapReport &= _
                "OPEN FILES : Visible and kept open [" & _
                createdDoc.DisplayName & _
                "]" & _
                vbCrLf

            'Do not close createdDoc.

        Catch exFile As Exception

            swapReport &= _
                "OPEN FILES : Failed [" & _
                filePath & _
                "] - " & _
                exFile.Message & _
                vbCrLf

        End Try

    Next

    swapReport &= _
        "OPEN FILES : Created model tabs open = " & _
        openedCount & _
        vbCrLf

End Sub


'====================================================
' PROCESS CREATED DRAWING TASKS
'
' Creates drawings after all model files and references
' have been created, replaced, updated, and saved.
'
' Created model files are intentionally left open.
' This supports the desired workflow:
'
'   create -> save -> leave open -> replace -> drawing/check-in
'====================================================
Sub ProcessCreatedDrawingTasks(ByRef swapReport As String)

    Try

        Dim taskList As String = ""

        Try
            taskList = CStr(SharedVariable("DriveConfig_CreatedDrawingTasks"))
        Catch
            taskList = ""
        End Try

        If Trim(taskList) = "" Then Exit Sub

        Dim rowSep As String = Chr(30)
        Dim colSep As String = Chr(31)

        Dim rows() As String = Split(taskList, rowSep)

        For Each Row As String In Rows

            If Trim(Row) <> "" Then

                Dim cols() As String = Split(Row, colSep)

                If UBound(cols) >= 2 Then

                    Dim targetLabel As String = cols(0)
                    Dim newModelFile As String = cols(1)
                    Dim sourceModelFile As String = cols(2)

                    If System.IO.File.Exists(newModelFile) Then

                        Dim modelDoc As Document = GetOpenDocumentByFullFileName(newModelFile)

                        If modelDoc Is Nothing Then
                            modelDoc = ThisApplication.Documents.Open(newModelFile, False)
                        End If

                        If Not modelDoc Is Nothing Then

                            CreateDriveGeneratorDrawing( _
                                modelDoc, _
                                targetLabel, _
                                swapReport, _
                                sourceModelFile)


                            '====================================================
                            ' DO NOT CLOSE modelDoc
                            '
                            ' Created model files should remain open for review
                            ' and Vault check-in.
                            '====================================================

                        End If

                    Else

                        swapReport &= _
                            "DRAWING : Skipped [" & _
                            targetLabel & _
                            "] because model file was not found [" & _
                            newModelFile & _
                            "]" & _
                            vbCrLf

                    End If

                End If

            End If

        Next

    Catch ex As Exception

        swapReport &= "DRAWING : ProcessCreatedDrawingTasks failed - " & ex.Message & vbCrLf

    End Try

End Sub
