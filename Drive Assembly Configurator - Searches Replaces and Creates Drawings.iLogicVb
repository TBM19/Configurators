'====================================================
' DRIVE ASSEMBLY CONFIGURATOR
' SEARCH / REPLACE / CREATE DRAWINGS
'====================================================
'
' Responsibilities:
'   1. Search Vault for matching existing components.
'   2. Store found Part Numbers in SharedVariables.
'   3. Store found file paths in SharedVariables.
'   4. Leave description SharedVariables alone.
'   5. Create new files only when no Vault match exists and user supplied a new PN/path.
'   6. Write generated descriptions into NEW files only.
'   7. Replace matching occurrences by Title.
'   8. Create drawings for configured parts when needed.
'
' Important:
'   - This rule does NOT own DriveConfig_DESC_* values.
'   - The description rule owns DriveConfig_DESC_*.
'   - Existing Vault files keep their existing Description iProperty.
'   - New files get Description from DriveConfig_DESC_*.
'
' RX2 special case:
'   - RX2 uses 5.0 in CC for Drive Frame related components:
'       DRIVE FRAME
'       CYLINDER MOUNT
'       CYLINDER MOUNT ASSY
'       STIFFENER
'		CROSSMEMBER
'
'====================================================

Sub Main()

    '====================================================
    ' DOCUMENT SAFETY
    '====================================================
    If ThisDoc.Document.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then
        MsgBox("This rule must be run from the top-level drive assembly.", vbCritical, "Drive Configurator")
        Exit Sub
    End If

    Dim oDoc As AssemblyDocument = CType(ThisDoc.Document, AssemblyDocument)

    '====================================================
    ' RESET SEARCH RESULT VALUES ONLY
    '====================================================
    ResetSearchResultSharedVariables()

	'====================================================
	' LIVE SEARCH ONLY FLAG
	'====================================================
	Dim liveSearchOnly As Boolean = False
	
	Try
	
	    If SharedVariable.Exists("DriveConfig_LiveSearchOnly") Then
	
	        liveSearchOnly = _
	            CBool(SharedVariable("DriveConfig_LiveSearchOnly"))
	
	    End If
	
	Catch
	
	    liveSearchOnly = False
	
	End Try

    '====================================================
    ' READ CONFIGURATION VALUES
    '====================================================
    Dim p As New System.Collections.Generic.Dictionary(Of String, String)

    p.Add("System", SafeiProp("System"))
    p.Add("Controls", SafeiProp("Controls"))
    p.Add("Valve_Mount_Style", SafeiProp("Valve_Mount_Style"))
    p.Add("Bore_Size", SafeiProp("Bore_Size"))
    p.Add("Stroke_Length", SafeiProp("Stroke_Length"))
    p.Add("CC", SafeiProp("CC"))
    p.Add("Shoe_Style", SafeiProp("Shoe_Style"))
    p.Add("SC", SafeiProp("SC"))
    p.Add("Quantity_of_Shoes", SafeiProp("Quantity_of_Shoes"))
    p.Add("Drive_Frame_Style", SafeiProp("Drive_Frame_Style"))
    p.Add("Drive_Frame_Gap", SafeiProp("Drive_Frame_Gap"))
    p.Add("Outside_Dimension", SafeiProp("Outside_Dimension"))
    p.Add("Inside_Dimension", SafeiProp("Inside_Dimension"))
    p.Add("Crossmember_Material", SafeiProp("Crossmember_Material"))
    p.Add("Crossmember_Height", SafeiProp("Crossmember_Height"))
    p.Add("Crossmember_Width", SafeiProp("Crossmember_Width"))
    p.Add("Finish", SafeiProp("Finish"))
    p.Add("Customer", SafeiProp("Customer"))
    p.Add("Customer_Crossmember_Height", SafeiProp("Customer_Crossmember_Height"))
    p.Add("Subframe", SafeiProp("Subframe"))
    p.Add("Subframe_Width", SafeiProp("Subframe_Width"))

    '====================================================
    ' LIVE SEARCH MODE
    '====================================================
    If liveSearchOnly Then
        RunLiveSearch(p)
        Exit Sub
    End If

    '====================================================
    ' FULL CONFIGURATOR RUN
    '====================================================
    RunFullConfigurator(oDoc, p)

End Sub


'====================================================
' LIVE SEARCH
'====================================================
' Finds existing Vault files and stores:
'   DriveConfig_PN_*
'   DriveConfig_FILE_*
'
' If no Vault match is found:
'   DriveConfig_PN_* is blank.
'   DriveConfig_FILE_* is blank.
'
' Descriptions are not touched here.
'====================================================
Sub RunLiveSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String))

    LiveSearchOne("DRIVE CORE", BuildDriveCoreSearch(p))
    LiveSearchOne("CROSS DRIVE SET", BuildCrossDriveSetSearch(p))
    LiveSearchOne("UPPER CROSS DRIVE SUPPORT", BuildUpperSupportSearch(p))
    LiveSearchOne("SERIAL PLATE", BuildSerialPlateSearch(p))

    LiveSearchOne("DRIVE ASSEMBLY", BuildDriveAssySearch(p))
    LiveSearchOne("CROSSMEMBER", BuildCrossmemberSearch(p))
    LiveSearchOne("DRIVE FRAME", BuildDriveFrameSearch(p))
    LiveSearchOne("CYLINDER MOUNT", BuildCylinderMountSearch(p))

    If Trim(GetBestInitialSourceFile("CYLINDER MOUNT ASSEMBLY", "", False)) = "" Then
        StoreConfiguratorComponentPartNumber("CYLINDER MOUNT ASSEMBLY", "NOT PLACED")
        StoreConfiguratorComponentFilePath("CYLINDER MOUNT ASSEMBLY", "")
    Else
        LiveSearchOne("CYLINDER MOUNT ASSEMBLY", BuildCylinderMountAssySearch(p))
    End If

    If Trim(GetBestInitialSourceFile("STIFFENER", "", False)) = "" Then
        StoreConfiguratorComponentPartNumber("STIFFENER", "NOT PLACED")
        StoreConfiguratorComponentFilePath("STIFFENER", "")
    Else
        LiveSearchOne("STIFFENER", BuildStiffenerSearch(p))
    End If

End Sub



'========================================
' Live Search
'========================================


Sub LiveSearchOne( _
    ByVal componentName As String, _
    ByVal searchCriteria As System.Collections.Generic.Dictionary(Of String, String))

    Try

        If Trim(GetMissingCriteriaText(searchCriteria)) <> "" Then
            StoreConfiguratorComponentPartNumber(componentName, "")
            StoreConfiguratorComponentFilePath(componentName, "")
            Exit Sub
        End If

        Dim foundFile As String = GetFileBySearchCriteriaWithWildcards(searchCriteria)

        If Trim(foundFile) = "" Then
            StoreConfiguratorComponentPartNumber(componentName, "")
            StoreConfiguratorComponentFilePath(componentName, "")
            Exit Sub
        End If

        StoreFoundVaultFile(componentName, foundFile)

    Catch

        StoreConfiguratorComponentPartNumber(componentName, "")
        StoreConfiguratorComponentFilePath(componentName, "")

    End Try

End Sub


'====================================================
' FULL CONFIGURATOR RUN
'====================================================
Sub RunFullConfigurator( _
    ByVal oDoc As AssemblyDocument, _
    ByVal p As System.Collections.Generic.Dictionary(Of String, String))

    Dim swapReport As String = "Part Swaps" & vbCrLf & vbCrLf
    Dim anySwap As Boolean = False

    '====================================================
    ' REQUIRED COMPONENT CHECK
    '====================================================
    Dim missingRequired As String = ""

    CheckRequiredComponentExists("PHANTOM CONTROLS ASSEMBLY", BuildControlsSearch(p), missingRequired)
    CheckRequiredComponentExists("CROSS DRIVE SET", BuildCrossDriveSetSearch(p), missingRequired)
    CheckRequiredComponentExists("DRIVE CORE", BuildDriveCoreSearch(p), missingRequired)
    CheckRequiredComponentExists("SERIAL PLATE", BuildSerialPlateSearch(p), missingRequired)
    CheckRequiredComponentExists("UPPER CROSS DRIVE SUPPORT", BuildUpperSupportSearch(p), missingRequired)
    CheckRequiredComponentExists("PHANTOM VALVE MOUNTS", BuildValveMountsSearch(p), missingRequired)
    CheckRequiredComponentExists("PHANTOM TIE TUBES", BuildPhantomTieTubesSearch(p), missingRequired)

    If Trim(missingRequired) <> "" Then

        SetStopFlag( _
            "Required Vault components are missing or could not be searched:" & vbCrLf & vbCrLf & _
            missingRequired)

        MsgBox( _
            "Configurator stopped." & vbCrLf & vbCrLf & _
            "The following required components are missing or could not be searched:" & vbCrLf & vbCrLf & _
            missingRequired & vbCrLf & vbCrLf & _
            "No new DRIVE ASSEMBLY number was requested.", _
            vbCritical, _
            "Required Components Missing")

        Exit Sub

    End If

    '====================================================
    ' CHECK FOR EXISTING DRIVE ASSY
    '====================================================
    Dim existingDriveAssy As String = GetFileBySearchCriteriaWithWildcards(BuildDriveAssySearch(p))

    If Trim(existingDriveAssy) <> "" Then

        StoreFoundVaultFile("DRIVE ASSEMBLY", existingDriveAssy)

        SetStopFlag("DRIVE ASSEMBLY : Existing matching drive assembly was found. Configurator stopped.")

        MsgBox( _
            "An existing DRIVE ASSEMBLY was found." & vbCrLf & vbCrLf & _
            "Part Number: " & GetPartNumber(existingDriveAssy) & vbCrLf & _
            "File: " & existingDriveAssy, _
            vbInformation, _
            "Existing Drive Assembly Found")

        Exit Sub

    End If

	'====================================================
	' CAPTURE SOURCE FILES BEFORE REPLACEMENT
	'
	' Only capture source files that exist in the starting
	' assembly before the Drive Frame is replaced.
	'
	' Parts inside the final/new Drive Frame are captured
	' later AFTER the Drive Frame swap.
	'====================================================
	Dim srcControls As String = GetBestInitialSourceFile("PHANTOM CONTROLS ASSEMBLY", "", False)
	Dim srcCrossDriveSet As String = GetBestInitialSourceFile("CROSS DRIVE SET", "", False)
	Dim srcDriveCore As String = GetBestInitialSourceFile("DRIVE CORE", "", False)
	Dim srcLowerSupports As String = GetBestInitialSourceFile("LOWER CROSS DRIVE SUPPORT", "", False)
	Dim srcSerialPlate As String = GetBestInitialSourceFile("SERIAL PLATE", "", False)
	Dim srcUpperSupport As String = GetBestInitialSourceFile("UPPER CROSS DRIVE SUPPORT", "", False)
	Dim srcValveMounts As String = GetBestInitialSourceFile("PHANTOM VALVE MOUNTS", "", False)
	
	Dim srcDriveFrame As String = GetBestInitialSourceFile("DRIVE FRAME", "", False)
	Dim srcCrossmember As String = GetBestInitialSourceFile("CROSSMEMBER", "", False)
	
	'These will be re-captured after DRIVE FRAME is replaced.
	Dim srcPhantomTieTubes As String = ""
	Dim srcCylinderMount As String = ""
	Dim srcStiffener As String = ""
	Dim srcCylinderMountAssy As String = ""
	Dim srcReinforcementPlate As String = ""

	'====================================================
	' SAVE TOP LEVEL DRIVE ASSY
	'
	' Capture the original DRIVE ASSY file before Save Copy As.
	' This original file is used later as the drawing template source.
	'====================================================
	Dim srcDriveAssyTemplateSource As String = ""
	
	Try
	    srcDriveAssyTemplateSource = oDoc.FullFileName
	Catch
	    srcDriveAssyTemplateSource = ""
	End Try
	
	'====================================================
	' GET NEW DRIVE ASSEMBLY PART NUMBER FROM FORM ONLY
	'====================================================
	Dim newDriveAssyPN As String = GetNewPartInputPN("DRIVE ASSEMBLY")
	
	If Trim(newDriveAssyPN) = "" Then
	    SetStopFlag("DRIVE ASSEMBLY : No form New PN was provided. Configurator cancelled.")
	    MsgBox( _
	        "No DRIVE ASSEMBLY New PN was provided from the form." & vbCrLf & vbCrLf & _
	        "Enter a Part Number for DRIVE ASSEMBLY in the configurator form before running.", _
	        vbExclamation, _
	        "Drive Assembly PN Missing")
	    Exit Sub
	End If

	Dim newDriveAssyFile As String = ""
	Dim newDriveAssyDoc As AssemblyDocument = Nothing
	
	If SaveCurrentAssemblyAsNewDriveAssy(oDoc, newDriveAssyPN, swapReport, newDriveAssyFile, newDriveAssyDoc) = False Then
	    SetStopFlag("DRIVE ASSEMBLY : Top-level drive assembly Save As was cancelled or failed. Configurator cancelled.")
	    MsgBox("Top-level DRIVE ASSEMBLY Save As was cancelled or failed. Rule cancelled.", vbExclamation, "Rule Cancelled")
	    Exit Sub
	End If
	
	If newDriveAssyDoc Is Nothing Then
	    MsgBox("The new DRIVE ASSEMBLY was created, but Inventor could not open it as the working assembly." & vbCrLf & vbCrLf & _
	           newDriveAssyFile, vbCritical, "Drive Configurator")
	    Exit Sub
	End If
	
	'From this point forward, oDoc must be the NEW copied DRIVE ASSY.
	oDoc = newDriveAssyDoc
	
	Try
	    oDoc.Activate()
	Catch
	End Try
	

    '====================================================
    ' REQUIRED COMPONENT REPLACEMENTS
    '====================================================
	ReplaceComponentByCriteria(oDoc, "PHANTOM CONTROLS ASSEMBLY", BuildControlsSearch(p), srcControls, swapReport, anySwap)
	ReplaceComponentByCriteria(oDoc, "CROSS DRIVE SET", BuildCrossDriveSetSearch(p), srcCrossDriveSet, swapReport, anySwap)
	ReplaceComponentByCriteria(oDoc, "DRIVE CORE", BuildDriveCoreSearch(p), srcDriveCore, swapReport, anySwap)
	ReplaceComponentByCriteria(oDoc, "SERIAL PLATE", BuildSerialPlateSearch(p), srcSerialPlate, swapReport, anySwap)
	ReplaceComponentByCriteria(oDoc, "UPPER CROSS DRIVE SUPPORT", BuildUpperSupportSearch(p), srcUpperSupport, swapReport, anySwap)
	ReplaceComponentByCriteria(oDoc, "PHANTOM VALVE MOUNTS", BuildValveMountsSearch(p), srcValveMounts, swapReport, anySwap)


	'====================================================
	' OPTIONAL / CONFIGURATION COMPONENTS
	'====================================================
	ReplaceOptionalComponent(oDoc, "LOWER CROSS DRIVE SUPPORT", BuildLowerSupportsSearch(p), srcLowerSupports, swapReport, anySwap)
	
	'====================================================
	' DRIVE FRAME
	'
	' Replace the Drive Frame first.
	' Everything below this point searches the final/new
	' assembly structure, just like the Push Parameters rule.
	'====================================================
	ReplaceOptionalComponent(oDoc, "DRIVE FRAME", BuildDriveFrameSearch(p), srcDriveFrame, swapReport, anySwap)
	
	
	'====================================================
	' RE-CAPTURE CURRENT FILES AFTER DRIVE FRAME SWAP
	'
	' Safe method:
	'   1. DRIVE FRAME is handled first.
	'   2. CYLINDER MOUNT ASSY is handled second.
	'   3. CYLINDER MOUNT is handled third.
	'   4. STIFFENER is handled fourth.
	'
	' This still uses the existing recursive replace-all logic,
	' but it does not open/edit newly created subassemblies directly.
	'====================================================
	
	srcPhantomTieTubes = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "PHANTOM TIE TUBES")
	srcCylinderMountAssy = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "CYLINDER MOUNT ASSEMBLY")
	srcCylinderMount = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "CYLINDER MOUNT")
	srcStiffener = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "STIFFENER")
	srcCrossmember = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "CROSSMEMBER")
	srcReinforcementPlate = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "REINFORCEMENT PLATE")
	
	
	'====================================================
	' PHANTOM TIE TUBES
	'====================================================
	If Trim(srcPhantomTieTubes) = "" Then
	
	    swapReport &= "PHANTOM TIE TUBES : Not currently placed - skipped" & vbCrLf
	
	Else
	
	    ReplaceComponentByCriteria( _
	        oDoc, _
	        "PHANTOM TIE TUBES", _
	        BuildPhantomTieTubesSearch(p), _
	        srcPhantomTieTubes, _
	        swapReport, _
	        anySwap)
	
	End If
	
	
	'====================================================
	' CYLINDER MOUNT ASSY
	'
	' Must happen before CYLINDER MOUNT and STIFFENER.
	'====================================================
	If Trim(srcCylinderMountAssy) = "" Then
	
	    StoreConfiguratorComponentPartNumber("CYLINDER MOUNT ASSEMBLY", "NOT PLACED")
	    StoreConfiguratorComponentFilePath("CYLINDER MOUNT ASSEMBLY", "")
	    swapReport &= "CYLINDER MOUNT ASSEMBLY : Not currently placed - skipped" & vbCrLf
	
	Else
	
	    ReplaceComponentByCriteria( _
	        oDoc, _
	        "CYLINDER MOUNT ASSEMBLY", _
	        BuildCylinderMountAssySearch(p), _
	        srcCylinderMountAssy, _
	        swapReport, _
	        anySwap)
	
	End If
	
	
	'====================================================
	' RE-CAPTURE AFTER CYLINDER MOUNT ASSY REPLACE
	'
	' This lets CYLINDER MOUNT and STIFFENER be found inside
	' the newly replaced or newly created CYLINDER MOUNT ASSY.
	'====================================================
	srcCylinderMount = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "CYLINDER MOUNT")
	srcStiffener = FindFirstOccurrenceFileByTitle(oDoc.ComponentDefinition.Occurrences, "STIFFENER")
	
	
	'====================================================
	' CYLINDER MOUNT
	'====================================================
	If Trim(srcCylinderMount) = "" Then
	
	    StoreConfiguratorComponentPartNumber("CYLINDER MOUNT", "NOT PLACED")
	    StoreConfiguratorComponentFilePath("CYLINDER MOUNT", "")
	    swapReport &= "CYLINDER MOUNT : Not currently placed - skipped" & vbCrLf
	
	Else
	
	    ReplaceComponentByCriteria( _
	        oDoc, _
	        "CYLINDER MOUNT", _
	        BuildCylinderMountSearch(p), _
	        srcCylinderMount, _
	        swapReport, _
	        anySwap)
	
	End If
	
	
	'====================================================
	' STIFFENER
	'====================================================
	If Trim(srcStiffener) = "" Then
	
	    StoreConfiguratorComponentPartNumber("STIFFENER", "NOT PLACED")
	    StoreConfiguratorComponentFilePath("STIFFENER", "")
	    swapReport &= "STIFFENER : Not currently placed - skipped" & vbCrLf
	
	Else
	
	    ReplaceComponentByCriteria( _
	        oDoc, _
	        "STIFFENER", _
	        BuildStiffenerSearch(p), _
	        srcStiffener, _
	        swapReport, _
	        anySwap)
	
	End If
	
	
	'====================================================
	' CROSSMEMBER
	'
	' Still handled from the top-level copied DRIVE ASSY.
	'====================================================
	ReplaceOptionalComponent(oDoc, "CROSSMEMBER", BuildCrossmemberSearch(p), srcCrossmember, swapReport, anySwap)
	
	
	'====================================================
	' REINFORCEMENT PLATE
	'
	' Still handled from the top-level copied DRIVE ASSY.
	'====================================================
	If Trim(srcReinforcementPlate) = "" Then
	
	    swapReport &= "REINFORCEMENT PLATE : Not currently placed - skipped" & vbCrLf
	
	Else
	
	    ReplaceComponentByCriteria( _
	        oDoc, _
	        "REINFORCEMENT PLATE", _
	        BuildReinforcementPlateSearch(p), _
	        srcReinforcementPlate, _
	        swapReport, _
	        anySwap)
	
	End If
	
'====================================================
' FINAL SAVE BEFORE OPENING CREATED FILES
'
' Commit all replacement/reference changes first.
'====================================================
Try
    oDoc.Update2(True)
Catch
    Try
        oDoc.Update()
    Catch
    End Try
End Try

Try
    oDoc.Save2(True)
Catch
    Try
        oDoc.Save()
    Catch
    End Try
End Try



'====================================================
' PUSH PARAMETERS BEFORE OPENING CREATED FILES
'
' The new top-level DRIVE ASSEMBLY must be active
' because the Push Parameters rule starts from
' ThisDoc.Document.
'====================================================
Try

    oDoc.Activate()

    iLogicVb.Automation.RunExternalRule( _
        oDoc, _
        "Push Parameters")

    swapReport &= _
        "PARAMETERS : Push Parameters completed." & _
        vbCrLf

Catch ex As Exception

    swapReport &= _
        "PARAMETERS : Push Parameters failed - " & _
        ex.Message & _
        vbCrLf

End Try


'====================================================
' OPEN CREATED FILES AND WRITE PROPERTIES
'
' This happens AFTER parameters have been pushed.
' Every newly created model is saved and left open.
'====================================================
Try

    ProcessCreatedPropertyTasks(swapReport)

Catch ex As Exception

    swapReport &= _
        "PROPERTIES : Created file processing failed - " & _
        ex.Message & _
        vbCrLf

End Try

'====================================================
' CREATE DRAWINGS AFTER REPLACEMENTS AND PROPERTIES
'
' Models are now created, replaced, opened, updated,
' and have correct Part Number / Description values.
'====================================================
Try
    CreateDriveGeneratorDrawing(oDoc, "DRIVE ASSEMBLY", swapReport, srcDriveAssyTemplateSource)
Catch ex As Exception
    swapReport &= "DRAWING : DRIVE ASSEMBLY failed - " & ex.Message & vbCrLf
End Try

Try
    ProcessCreatedDrawingTasks(swapReport)
Catch ex As Exception
    swapReport &= "DRAWING : Created child drawing processing failed - " & ex.Message & vbCrLf
End Try

'====================================================
' FINAL OPEN OF ALL CREATED MODEL FILES
'
' Run after parameter updates, property writes, and
' drawing creation. This guarantees each created model
' has a visible Inventor document tab and remains open.
'====================================================
Try

    OpenAllCreatedFilesAndKeepOpen(swapReport)

Catch ex As Exception

    swapReport &= _
        "OPEN FILES : Final open-all operation failed - " & _
        ex.Message & _
        vbCrLf

End Try


'====================================================
' FINAL SAVE AFTER DRAWING CREATION
' Forces Inventor/Vault to see final reference state.
'====================================================


'Try
'    oDoc.Rebuild2()
'Catch
'End Try

Try
    oDoc.Update2(True)
Catch
    Try
        oDoc.Update()
    Catch
    End Try
End Try

Try
    oDoc.Save2(True)
Catch
    Try
        oDoc.Save()
    Catch
    End Try
End Try

Try
    ThisApplication.ActiveView.Update()
Catch
End Try


''====================================================
' MAKE NEW DRIVE ASSY ACTIVE FOR VAULT CHECK-IN
'
' Created child files are intentionally left open by
' SaveAsCore().
'
' This activates the new top-level DRIVE ASSY at the end
' so the user is returned to the main assembly for review
' and Vault check-in.
'====================================================
Try
    ActivateDocumentForVault(oDoc)
Catch
End Try


MsgBox(swapReport, vbOKOnly + vbInformation, "Swap Results")

End Sub


'====================================================
' SEARCH CRITERIA BUILDERS
'====================================================
Function NewCriteria() As System.Collections.Generic.Dictionary(Of String, String)

    Dim d As New System.Collections.Generic.Dictionary(Of String, String)

    'Every Vault search created by this rule is restricted
    'to files assigned to the MOBILE Vault category.
    d.Add("Category Name", "MOBILE")

    Return d

End Function


Sub AddCriteria( _
    ByVal d As System.Collections.Generic.Dictionary(Of String, String), _
    ByVal key As String, _
    ByVal value As String)

    d.Add(key, value)

End Sub


Function GetSearchCC( _
    ByVal p As System.Collections.Generic.Dictionary(Of String, String), _
    ByVal componentTitle As String) As String

    Dim systemValue As String = UCase(Trim(GetP(p, "System")))
    Dim titleValue As String = UCase(Trim(componentTitle))

    If systemValue = "RX2" Then

        Select Case titleValue

			Case "PHANTOM CONTROLS ASSEMBLY", _
				 "DRIVE FRAME", _
			     "CYLINDER MOUNT", _
			     "CYLINDER MOUNT ASSEMBLY", _
			     "STIFFENER", _
			     "CROSSMEMBER", _
			     "REINFORCEMENT PLATE"
			
			    Return "5.0 in"

        End Select

    End If

    Return GetP(p, "CC")

End Function



Function BuildControlsSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String)) As System.Collections.Generic.Dictionary(Of String, String)
    Dim d = NewCriteria()
    AddCriteria(d, "Title", "PHANTOM CONTROLS ASSEMBLY")
    AddCriteria(d, "Controls", GetP(p, "Controls"))
	AddCriteria(d, "Valve Mount Style", GetP(p, "Valve_Mount_Style"))
	AddCriteria(d, "CC", GetP(p, "CC"))
    Return d
End Function


Function BuildCrossDriveSetSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String)) As System.Collections.Generic.Dictionary(Of String, String)
    Dim d = NewCriteria()
    AddCriteria(d, "Title", "CROSS DRIVE SET")
    AddCriteria(d, "System", GetP(p, "System"))
    AddCriteria(d, "Bore Size", GetP(p, "Bore_Size"))
    AddCriteria(d, "CC", GetP(p, "CC"))
    AddCriteria(d, "Shoe Style", GetP(p, "Shoe_Style"))
    AddCriteria(d, "SC", GetP(p, "SC"))
    AddCriteria(d, "Quantity of Shoes", GetP(p, "Quantity_of_Shoes"))
    AddCriteria(d, "Finish", GetP(p, "Finish"))
    Return d
End Function


Function BuildDriveCoreSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String)) As System.Collections.Generic.Dictionary(Of String, String)
    Dim d = NewCriteria()
    AddCriteria(d, "Title", "DRIVE CORE")
    AddCriteria(d, "System", GetP(p, "System"))
    AddCriteria(d, "Valve Mount Style", GetP(p, "Valve_Mount_Style"))
    AddCriteria(d, "Bore Size", GetP(p, "Bore_Size"))
    AddCriteria(d, "CC", GetP(p, "CC"))
    AddCriteria(d, "Stroke Length", GetP(p, "Stroke_Length"))
    Return d
End Function


Function BuildSerialPlateSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String)) As System.Collections.Generic.Dictionary(Of String, String)
    Dim d = NewCriteria()
    AddCriteria(d, "Title", "SERIAL PLATE")
    AddCriteria(d, "System", GetP(p, "System"))
    AddCriteria(d, "Bore Size", GetP(p, "Bore_Size"))
    Return d
End Function


Function BuildUpperSupportSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String)) As System.Collections.Generic.Dictionary(Of String, String)
    Dim d = NewCriteria()
    AddCriteria(d, "Title", "UPPER CROSS DRIVE SUPPORT")
    AddCriteria(d, "Bore Size", GetP(p, "Bore_Size"))
    AddCriteria(d, "SC", GetP(p, "SC"))
    AddCriteria(d, "Finish", GetP(p, "Finish"))
    Return d
End Function


Function BuildValveMountsSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String)) As System.Collections.Generic.Dictionary(Of String, String)
    Dim d = NewCriteria()
    AddCriteria(d, "Title", "PHANTOM VALVE MOUNTS")
    AddCriteria(d, "Finish", GetP(p, "Finish"))
	AddCriteria(d, "Valve Mount Style", GetP(p, "Valve_Mount_Style"))
    Return d
End Function


Function BuildPhantomTieTubesSearch(ByVal p As System.Collections.Generic.Dictionary(Of String, String)) As System.Collections.Generic.Dictionary(Of String, String)
    Dim d = NewCriteria()
    AddCriteria(d, "Title", "PHANTOM TIE TUBES")
    AddCriteria(d, "Valve Mount Style", GetP(p, "Valve_Mount_Style"))
    AddCriteria(d, "Drive Frame Gap", GetP(p, "Drive_Frame_Gap"))
    AddCriteria(d, "Finish", GetP(p, "Finish"))
    Return d
End Function


