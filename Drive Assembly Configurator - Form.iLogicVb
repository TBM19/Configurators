'==================================================
' APPLY ALL CONTROLS
'==================================================
' Used by Verify.
' Pushes every current form value into the document.
'==================================================

Sub ApplyAllControls( _
    ByVal oDoc As Document, _
    ByVal paramControls As System.Collections.Generic.Dictionary(Of String, System.Windows.Forms.Control))

    For Each kvp As System.Collections.Generic.KeyValuePair(Of String, System.Windows.Forms.Control) In paramControls

        Dim paramName As String = kvp.Key
        Dim ctrl As System.Windows.Forms.Control = kvp.Value

        Dim expressionValue As String = GetControlValue(ctrl)

        If Trim(expressionValue) <> "" Then
            SetParameterValue(oDoc, paramName, expressionValue)
        End If

    Next

End Sub


'==================================================
' GET CONTROL VALUE
'==================================================
' Reads the current value from either a ComboBox or TextBox.
'==================================================

Function GetControlValue(ByVal ctrl As System.Windows.Forms.Control) As String

    If TypeOf ctrl Is System.Windows.Forms.ComboBox Then

        Dim cbo As System.Windows.Forms.ComboBox = _
            CType(ctrl, System.Windows.Forms.ComboBox)

        If cbo.SelectedItem Is Nothing Then Return ""

        Return CStr(cbo.SelectedItem)

    ElseIf TypeOf ctrl Is System.Windows.Forms.TextBox Then

        Dim txt As System.Windows.Forms.TextBox = _
            CType(ctrl, System.Windows.Forms.TextBox)

        Return txt.Text

    End If

    Return ""

End Function


'==================================================
' GET USER PARAMETERS
'==================================================
' Returns user parameters from a part or assembly.
'==================================================

Function GetUserParameters(ByVal oDoc As Document) As UserParameters

    Try

        If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then

            Dim oAsm As AssemblyDocument = CType(oDoc, AssemblyDocument)
            Return oAsm.ComponentDefinition.Parameters.UserParameters

        ElseIf oDoc.DocumentType = DocumentTypeEnum.kPartDocumentObject Then

            Dim oPart As PartDocument = CType(oDoc, PartDocument)
            Return oPart.ComponentDefinition.Parameters.UserParameters

        End If

    Catch
    End Try

    Return Nothing

End Function


'==================================================
' GET USER PARAMETER
'==================================================
' Safely gets one user parameter by name.
'==================================================

Function GetUserParameter( _
    ByVal oDoc As Document, _
    ByVal paramName As String) As UserParameter

    Try

        Dim oParams As UserParameters = GetUserParameters(oDoc)

        If oParams Is Nothing Then Return Nothing

        Return oParams.Item(paramName)

    Catch

        Return Nothing

    End Try

End Function


'==================================================
' GET PARAMETER DISPLAY VALUE
'==================================================
' Text and Boolean parameters use Value.
'
' Numeric/unit parameters first try the exported
' custom iProperty because that respects parameter
' custom property formatting like:
'
'   48.0 in
'   60.0 in
'   40.0 in
'
' If the custom iProperty does not exist yet, it
' falls back to the parameter expression.
'==================================================

Function GetParameterDisplayValue( _
    ByVal oDoc As Document, _
    ByVal paramName As String) As String

    Try

        Dim oParam As UserParameter = GetUserParameter(oDoc, paramName)

        If oParam Is Nothing Then Return ""

        If IsTextOrBooleanParameter(oParam) Then
            Return CStr(oParam.Value)
        End If

        '==================================================
        ' NUMERIC / LENGTH PARAMETER
        ' Get the exposed custom iProperty value first.
        ' This should show 48.0 in instead of 48 in.
        '==================================================

        Try

            Dim propValue As String = SafeProperty(oDoc, paramName)

            If Trim(propValue) <> "" Then
                Return propValue
            End If

        Catch
        End Try

        '==================================================
        ' FALLBACK
        '==================================================

        Try
            Return FormatDisplayedExpression(oParam.Expression)
        Catch
            Return oParam.Expression
        End Try

    Catch

        Return ""

    End Try

End Function


'==================================================
' FORMAT DISPLAYED EXPRESSION
'==================================================
' Converts:
'
'   48 in    -> 48.0 in
'   60 in    -> 60.0 in
'   40 in    -> 40.0 in
'   31.5 in  -> 31.5 in
'
' Used for form display.
'==================================================

Function FormatDisplayedExpression( _
    ByVal expressionText As String) As String

    Try

        Dim s As String = Trim(expressionText)

        If s = "" Then Return ""

        Dim lowerS As String = LCase(s)

        If Not lowerS.Contains("in") Then
            Return s
        End If

        Dim numberText As String = lowerS

        numberText = Replace(numberText, "inches", "")
        numberText = Replace(numberText, "inch", "")
        numberText = Replace(numberText, " in", "")
        numberText = Replace(numberText, "in", "")
        numberText = Trim(numberText)

        If numberText = "" Then Return s

        Dim numericValue As Double = 0

        If Not Double.TryParse(numberText, numericValue) Then
            Return s
        End If

        If numberText.Contains(".") Then

            Return numberText & " in"

        Else

            Return numericValue.ToString("0.0") & " in"

        End If

    Catch

        Return expressionText

    End Try

End Function





'==================================================
' SET PARAMETER VALUE
'==================================================
' Text and Boolean parameters use Value.
' Numeric/unit parameters use Expression.
'
' For inch values:
'   33      -> 33.0 in
'   33 in   -> 33.0 in
'   33.0    -> 33.0 in
'   33.25   -> 33.25 in
'
' This prevents whole inch dimensions from being
' stored without the .0 needed for Vault searching.
'==================================================
Sub SetParameterValue( _
    ByVal oDoc As Document, _
    ByVal paramName As String, _
    ByVal expressionValue As String)

    If Trim(expressionValue) = "" Then Exit Sub

    Dim oParam As UserParameter = GetUserParameter(oDoc, paramName)

    If oParam Is Nothing Then Exit Sub

    Try

        If IsTextOrBooleanParameter(oParam) Then

            If IsBooleanParameter(oParam) Then
                oParam.Value = CBool(expressionValue)
            Else
                oParam.Value = expressionValue
            End If

        Else

            Dim expr As String = FormatUserEnteredParameterExpression( _
                oParam, _
                expressionValue)

            oParam.Expression = expr

        End If

    Catch ex As Exception

        Throw New Exception( _
            "Parameter: " & paramName & vbCrLf & _
            "Value: " & expressionValue & vbCrLf & vbCrLf & _
            ex.Message)

    End Try

End Sub



'==================================================
' FORMAT USER ENTERED PARAMETER EXPRESSION
'==================================================
' Keeps whole inch values as one decimal place.
'
' Examples:
'   33       -> 33.0 in
'   33 in    -> 33.0 in
'   33.0     -> 33.0 in
'   33.25    -> 33.25 in
'   33.25 in -> 33.25 in
'==================================================
Function FormatUserEnteredParameterExpression( _
    ByVal oParam As UserParameter, _
    ByVal rawValue As String) As String

    Dim expr As String = Trim(rawValue)

    If expr = "" Then Return expr

    Dim lowerExpr As String = LCase(expr)

    '==================================================
    ' ONLY FORMAT LENGTH PARAMETERS USING INCHES
    '==================================================
    Dim unitsText As String = ""

    Try
        unitsText = LCase(CStr(oParam.Units))
    Catch
        unitsText = ""
    End Try

    Dim usesInches As Boolean = False

    If lowerExpr.Contains("in") Then
        usesInches = True
    ElseIf unitsText = "in" Or unitsText = "inch" Or unitsText = "inches" Then
        usesInches = True
    End If

    If usesInches = False Then
        Return expr
    End If

    '==================================================
    ' REMOVE UNIT TEXT SO WE CAN FORMAT THE NUMBER
    '==================================================
    Dim numberText As String = lowerExpr

    numberText = Replace(numberText, "inches", "")
    numberText = Replace(numberText, "inch", "")
    numberText = Replace(numberText, " in", "")
    numberText = Replace(numberText, "in", "")
    numberText = Trim(numberText)

    If numberText = "" Then Return expr

    Dim numericValue As Double = 0

    If Double.TryParse(numberText, numericValue) = False Then
        Return expr
    End If

    '==================================================
    ' WHOLE NUMBERS GET ONE DECIMAL PLACE
    ' DECIMAL NUMBERS KEEP THEIR DECIMAL VALUE
    '==================================================
    If numberText.Contains(".") Then

        Return numberText & " in"

    Else

        Return numericValue.ToString("0.0") & " in"

    End If

End Function


'==================================================
' PARAMETER TYPE CHECKS
'==================================================

Function IsTextOrBooleanParameter(ByVal oParam As UserParameter) As Boolean

    Try

        Dim unitText As String = UCase(CStr(oParam.Units))

        If unitText = "TEXT" Then Return True
        If unitText = "BOOLEAN" Then Return True
        If unitText = "TRUE/FALSE" Then Return True

    Catch
    End Try

    Return False

End Function


Function IsBooleanParameter(ByVal oParam As UserParameter) As Boolean

    Try

        Dim unitText As String = UCase(CStr(oParam.Units))

        If unitText = "BOOLEAN" Then Return True
        If unitText = "TRUE/FALSE" Then Return True

    Catch
    End Try

    Return False

End Function


'==================================================
' GET NUMERIC PARAMETER VALUE
'==================================================
' Gets the numeric part of a parameter expression.
' Example:
'   "10.0 in" becomes 10.0
'==================================================

Function GetParameterNumericValue( _
    ByVal oDoc As Document, _
    ByVal paramName As String) As Double

    Dim displayValue As String = GetParameterDisplayValue(oDoc, paramName)

    Dim numberValue As Double = 0

    If TryGetNumber(displayValue, numberValue) Then
        Return numberValue
    End If

    Return 0

End Function


'==================================================
' TRY GET NUMBER
'==================================================
' Removes common units before converting to a number.
'==================================================

Function TryGetNumber( _
    ByVal inputValue As String, _
    ByRef numberValue As Double) As Boolean

    Try

        Dim cleanValue As String = inputValue

        cleanValue = UCase(cleanValue)
        cleanValue = Replace(cleanValue, "IN", "")
        cleanValue = Replace(cleanValue, "MM", "")
        cleanValue = Replace(cleanValue, "UL", "")
        cleanValue = Replace(cleanValue, Chr(34), "")
        cleanValue = Trim(cleanValue)

        numberValue = CDbl(cleanValue)

        Return True

    Catch

        numberValue = 0
        Return False

    End Try

End Function




'==================================================
' UPDATE DOCUMENT
'==================================================
' Forces iLogic parameter output and Inventor update.
' This is what makes the assembly start adapting before
' the description/search rules read the values.
'==================================================

Sub UpdateDocument(ByVal oDoc As Document)

    If oDoc Is Nothing Then Exit Sub

    ' Push the iLogic parameter changes out to Inventor first.
    Try
        RuleParametersOutput()
    Catch
    End Try

    Try
        iLogicVb.UpdateWhenDone = True
    Catch
    End Try

    ' Force Inventor to solve the model.
    Try
        oDoc.Update2(True)
    Catch
        Try
            oDoc.Update()
        Catch
        End Try
    End Try

    ' Extra update pass for adaptive/derived geometry.
    Try
        InventorVb.DocumentUpdate()
    Catch
    End Try

    ' Refresh graphics.
    Try
        ThisApplication.ActiveView.Update()
    Catch
    End Try

End Sub




'==================================================
' VERIFY DRIVE CONFIGURATION
'==================================================
' Compares selected custom properties from parent to children.
'==================================================

Function VerifyDriveConfiguration(ByVal oDoc As Document) As String

    Dim report As String = ""

    Try

        If oDoc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then
            Return "Verification can only run from the top-level drive assembly."
        End If

        Dim oAsm As AssemblyDocument = CType(oDoc, AssemblyDocument)
        Dim oDef As AssemblyComponentDefinition = oAsm.ComponentDefinition

        For Each oOcc As ComponentOccurrence In oDef.Occurrences
            CheckOccurrenceRecursive(oDoc, oOcc, report)
        Next

    Catch ex As Exception

        report &= vbCrLf & _
                  "FAILED VERIFY: " & ex.Message

    End Try

    Return report

End Function


'==================================================
' CHECK OCCURRENCE RECURSIVE
'==================================================
' Walks the full assembly tree.
' This does not rely on a fixed subassembly structure.
'==================================================

Sub CheckOccurrenceRecursive( _
    ByVal oParentDoc As Document, _
    ByVal oOcc As ComponentOccurrence, _
    ByRef report As String)

    Try

        If oOcc.Suppressed Then Exit Sub

        Dim oChildDoc As Document = oOcc.Definition.Document

        If oChildDoc Is Nothing Then Exit Sub

        CompareProperty(oParentDoc, oChildDoc, "System", report)
        CompareProperty(oParentDoc, oChildDoc, "Controls", report)
        CompareProperty(oParentDoc, oChildDoc, "Valve_Mount_Style", report)

        CompareProperty(oParentDoc, oChildDoc, "Bore_Size", report)
        CompareProperty(oParentDoc, oChildDoc, "Stroke_Length", report)
        CompareProperty(oParentDoc, oChildDoc, "CC", report)
        CompareProperty(oParentDoc, oChildDoc, "SC", report)

        CompareProperty(oParentDoc, oChildDoc, "Shoe_Style", report)
        CompareProperty(oParentDoc, oChildDoc, "Quantity_of_Shoes", report)

        CompareProperty(oParentDoc, oChildDoc, "Drive_Frame_Style", report)
        CompareProperty(oParentDoc, oChildDoc, "Drive_Frame_Gap", report)

        CompareProperty(oParentDoc, oChildDoc, "Outside_Dimension", report)
        CompareProperty(oParentDoc, oChildDoc, "Inside_Dimension", report)

        CompareProperty(oParentDoc, oChildDoc, "Crossmember_Material", report)
        CompareProperty(oParentDoc, oChildDoc, "Crossmember_Height", report)
        CompareProperty(oParentDoc, oChildDoc, "Crossmember_Width", report)

        CompareProperty(oParentDoc, oChildDoc, "Finish", report)
        CompareProperty(oParentDoc, oChildDoc, "Customer", report)
        CompareProperty(oParentDoc, oChildDoc, "Customer_Crossmember_Height", report)

        CompareProperty(oParentDoc, oChildDoc, "Subframe", report)
        CompareProperty(oParentDoc, oChildDoc, "Subframe_Width", report)

        If oOcc.DefinitionDocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then

            Dim oSubDef As AssemblyComponentDefinition = _
                TryCast(oOcc.Definition, AssemblyComponentDefinition)

            If Not oSubDef Is Nothing Then

                For Each oSubOcc As ComponentOccurrence In oSubDef.Occurrences
                    CheckOccurrenceRecursive(oParentDoc, oSubOcc, report)
                Next

            End If

        End If

    Catch ex As Exception

        report &= vbCrLf & _
                  "FAILED: " & oOcc.Name & _
                  " - " & ex.Message

    End Try

End Sub


'==================================================
' COMPARE PROPERTY
'==================================================
' Compares one custom property between parent and child.
'==================================================

Sub CompareProperty( _
    ByVal oParentDoc As Document, _
    ByVal oChildDoc As Document, _
    ByVal propName As String, _
    ByRef report As String)

    Try

        If Not PropertyExists(oChildDoc, propName) Then Exit Sub

        Dim parentValue As String = SafeProperty(oParentDoc, propName)
        Dim childValue As String = SafeProperty(oChildDoc, propName)

        parentValue = Trim(UCase(parentValue))
        childValue = Trim(UCase(childValue))

        If parentValue <> childValue Then

            report &= vbCrLf & _
                      oChildDoc.DisplayName & vbCrLf & _
                      "  Property : " & propName & vbCrLf & _
                      "  Parent   : " & parentValue & vbCrLf & _
                      "  Child    : " & childValue & vbCrLf

        End If

    Catch
    End Try

End Sub


'==================================================
' PROPERTY EXISTS
'==================================================

Function PropertyExists( _
    ByVal oDoc As Document, _
    ByVal propName As String) As Boolean

    Try

        Dim oSet As PropertySet = _
            oDoc.PropertySets.Item("Inventor User Defined Properties")

        Dim oProp As Inventor.Property = oSet.Item(propName)

        Return True

    Catch

        Return False

    End Try

End Function


'==================================================
' SAFE PROPERTY READ
'==================================================

Function SafeProperty( _
    ByVal oDoc As Document, _
    ByVal propName As String) As String

    Try

        Dim oSet As PropertySet = _
            oDoc.PropertySets.Item("Inventor User Defined Properties")

        Return CStr(oSet.Item(propName).Value)

    Catch

        Return ""

    End Try

End Function


'==================================================
' DEFAULT NON-WIDE SHOE
'==================================================
' Used when switching away from Wide Shoe.
'==================================================

Function GetDefaultNonWideShoe(ByVal boreValue As Double) As String

    If Math.Abs(boreValue - 3.5) < 0.0001 Then
        Return "Long Shoe 8 Hole (LS8H)"
    End If

    Return "Long Shoe 6 Hole (LS6H)"

End Function


'==================================================
' DEFAULT ALLOWED SHOE
'==================================================
' Keeps current shoe if valid.
' Otherwise returns a valid shoe for the bore size.
'==================================================

Function GetDefaultAllowedShoe( _
    ByVal oDoc As Document, _
    ByVal boreValue As Double, _
    ByVal currentShoeStyle As String) As String

    If Math.Abs(boreValue - 3.0) < 0.0001 Then

        If currentShoeStyle = "LONG SHOE 8 HOLE (LS8H)" Then
            Return "Long Shoe 6 Hole (LS6H)"
        End If

    ElseIf Math.Abs(boreValue - 3.5) < 0.0001 Then

        If currentShoeStyle = "LONG SHOE 6 HOLE (LS6H)" Or _
           currentShoeStyle = "SHORT SHOE 6 HOLE (SHS6H)" Then

            Return "Long Shoe 8 Hole (LS8H)"

        End If

    End If

    Return GetParameterDisplayValue(oDoc, "Shoe_Style")

End Function


'==================================================
' UPDATE COMPONENT DESCRIPTIONS
'==================================================
' Runs the Generate Descriptions rule in preview mode.
'
' This is called twice during initialization:
'
'   1. Before live search:
'      Builds generated descriptions for new parts.
'
'   2. After live search:
'      Allows the description rule to use any Vault
'      file paths found by the search rule.
'
' Required SharedVariables:
'
'   DriveConfig_DescriptionPreviewOnly
'
' Description Rule should output:
'
'   DriveConfig_DESC_DRIVE_ASSY
'   DriveConfig_DESC_CROSSMEMBER
'   DriveConfig_DESC_DRIVE_FRAME
'   DriveConfig_DESC_DRIVE_CORE
'   DriveConfig_DESC_CROSS_DRIVE_SET
'   DriveConfig_DESC_UPPER_CROSS_DRIVE_SUPPORT
'   DriveConfig_DESC_SERIAL_PLATE
'   DriveConfig_DESC_CYLINDER_MOUNT
'   DriveConfig_DESC_CYLINDER_MOUNT_ASSY
'   DriveConfig_DESC_STIFFENER
'==================================================

Sub UpdateComponentDescriptions( _
    ByVal oDoc As Document, _
    ByVal componentRows As System.Collections.Generic.List(Of ComponentWorkspaceRow))

    If componentRows Is Nothing Then Exit Sub

    '--------------------------------------------------
    ' Make sure parameters/model are current before
    ' the description rule reads values.
    '--------------------------------------------------

    Try
        If Not oDoc Is Nothing Then
            UpdateDocument(oDoc)
        End If
    Catch
    End Try

    '--------------------------------------------------
    ' Tell the description rule to only populate
    ' SharedVariables and not write/save files.
    '--------------------------------------------------

    Try
        SharedVariable("DriveConfig_DescriptionPreviewOnly") = True
    Catch
    End Try

    '--------------------------------------------------
    ' Run the actual Generate Descriptions rule.
    '--------------------------------------------------

    Try

        RunDescriptionRuleSafe()

    Catch ex As Exception

        Try
            SharedVariable("DriveConfig_DescriptionPreviewOnly") = False
        Catch
        End Try

        MessageBox.Show( _
            "Description preview failed." & vbCrLf & vbCrLf & _
            ex.Message, _
            "Drive Configurator")

        Exit Sub

    End Try

    '--------------------------------------------------
    ' Turn preview mode back off.
    '--------------------------------------------------

    Try
        SharedVariable("DriveConfig_DescriptionPreviewOnly") = False
    Catch
    End Try


End Sub


Sub InitializeConfiguratorData( _
    ByVal oDoc As Document, _
    ByVal componentRows As System.Collections.Generic.List(Of ComponentWorkspaceRow), _
    ByVal txtComponentPNReport As System.Windows.Forms.TextBox)

    If oDoc Is Nothing Then Exit Sub

    EnforceDynamicRules(oDoc)

    UpdateDocument(oDoc)

    '------------------------------------------
    ' SEARCH FIRST
    '------------------------------------------

	RunLiveSearchAndUpdateWorkspace( _
	    oDoc, _
	    componentRows, _
	    txtComponentPNReport)


    '------------------------------------------
    ' DESCRIPTIONS SECOND
    '------------------------------------------

    UpdateComponentDescriptions( _
        oDoc, _
        componentRows)

    '------------------------------------------
    ' FINAL UI REFRESH
    '------------------------------------------

    UpdateComponentPartNumberWorkspaceFromShared( _
        componentRows, _
        txtComponentPNReport)


End Sub


'==================================================
' RUN SEARCH RULE SAFE
'==================================================
' Runs the live search / search-replace rule.
'
' Tries folder-qualified name first.
' Then tries plain external rule name.
'==================================================

Sub RunSearchRuleSafe()

    Try
        iLogicVb.RunExternalRule( _
            "Drive Assembly Configurator\Drive Assembly Configurator - Searches Replaces and Creates Drawings")
        Exit Sub
    Catch
    End Try

    Try
        iLogicVb.RunExternalRule( _
            "Drive Assembly Configurator - Searches Replaces and Creates Drawings")
        Exit Sub
    Catch ex As Exception

        Throw New Exception( _
            "Could not run Search / Replace rule." & vbCrLf & vbCrLf & _
            "Tried:" & vbCrLf & _
            "Drive Assembly Configurator\Drive Assembly Configurator - Searches Replaces and Creates Drawings" & vbCrLf & _
            "Drive Assembly Configurator - Searches Replaces and Creates Drawings" & vbCrLf & vbCrLf & _
            ex.Message)

    End Try

End Sub


'==================================================
' RUN DESCRIPTION RULE SAFE
'==================================================
' Runs the Generate Descriptions external rule.
'
' Tries:
'   1. Folder-qualified external rule name
'   2. Plain external rule name
'
' Actual rule name:
'   Drive Assembly Configurator - Generate Descriptions
'==================================================

Sub RunDescriptionRuleSafe()

    Try
        iLogicVb.RunExternalRule( _
            "Drive Assembly Configurator\Drive Assembly Configurator - Generates Descriptions")
        Exit Sub
    Catch
    End Try

    Try
        iLogicVb.RunExternalRule( _
            "Drive Assembly Configurator - Generates Descriptions")
        Exit Sub
    Catch ex As Exception

        Throw New Exception( _
            "Could not run Generate Descriptions rule." & vbCrLf & vbCrLf & _
            "Tried:" & vbCrLf & _
            "Drive Assembly Configurator\Drive Assembly Configurator - Generates Descriptions" & vbCrLf & _
            "Drive Assembly Configurator - Generates Descriptions" & vbCrLf & vbCrLf & _
            ex.Message)

    End Try

End Sub


